---
// Self-hosted fonts (no Google Fonts CDN, GDPR). Latin subset covers German umlauts too.
// Titles and UI: IBM Plex Sans (titles in Bold 700, chosen in the round 10 font trial).
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/geist-mono/latin-600.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/hanken-grotesk/latin-600.css';
// Inter is used only inside the LISSA Asset mockup, as in the product's design system.
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import plex700 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url';
import hanken400 from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../content/site';
import { switchPath, locales } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
  /** Home page has the header over the accent band and same-page anchors. */
  home?: boolean;
  /** Template pages: the first section is dark, so the header starts transparent and turns white on scroll. */
  darkHero?: boolean;
  noindex?: boolean;
}

const { locale = Astro.currentLocale ?? 'en', home = false, darkHero = false, noindex = false } = Astro.props;
const t = getContent(locale ?? Astro.currentLocale);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Share cover: one 1200 × 630 image per language (public/og.png, public/og-de.png).
const ogImage = new URL(locale === 'de' ? '/og-de.png' : '/og.png', Astro.site);
const alternates = locales.map((l) => ({ lang: l, href: new URL(switchPath(Astro.url.pathname, l), Astro.site).href }));
const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Spind',
  description: t.meta.description,
  brand: { '@type': 'Brand', name: 'Spind' },
  url: new URL(locale === 'de' ? '/de/' : '/', Astro.site).href,
  image: ogImage.href,
});
const base = home ? '' : locale === 'en' ? '/' : `/${locale}/`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#EEF2F6" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={plex700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hanken400} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Spind" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'de' ? 'en_GB' : 'de_DE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />
    {home && <script type="application/ld+json" set:html={orgLd} />}

    <!-- Mark that JS runs, so reveal animations only hide content when they can show it again. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!--
      Cloudflare Web Analytics (cookieless). TODO: add the token once the domain is live, then uncomment.
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "YOUR_TOKEN"}'></script>
    -->
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header overlay={home || darkHero} base={base} locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer base={base} locale={locale} />
    <!--
      Grid fit, run before first paint and again by main.ts on resize and font load.
      1. Tile groups [data-fit]: every tile gets enough whole rows for its text (same for the whole group).
      (Vertical sizes follow the Figma design in px; blocks are no longer snapped to whole cells.)
    -->
    <script is:inline>
      window.__gridFit = function () {
        var pr = document.createElement('div');
        pr.style.cssText = 'position:absolute;visibility:hidden;width:var(--cell)';
        document.body.appendChild(pr);
        var c = pr.getBoundingClientRect().width;
        pr.remove();
        if (!c) return;
        var q = function (s, r) { return [].slice.call((r || document).querySelectorAll(s)); };
        q('[data-fit]').forEach(function (g) {
          var tiles = q('.tile', g), extra = 0;
          tiles.forEach(function (t) { t.style.removeProperty('--rows'); });
          tiles.forEach(function (t) {
            var base = parseFloat(getComputedStyle(t).getPropertyValue('--rows')) || 2;
            var need = Math.ceil(t.scrollHeight / c - 0.02);
            if (need - base > extra) extra = need - base;
          });
          if (extra > 0) tiles.forEach(function (t) {
            var base = parseFloat(getComputedStyle(t).getPropertyValue('--rows')) || 2;
            t.style.setProperty('--rows', base + extra);
          });
        });
      };
      window.__gridFit();
    </script>
    <script>
      import '../scripts/main';
      import '../scripts/sound';
    </script>
  </body>
</html>
