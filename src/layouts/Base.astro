---
// Self-hosted fonts (no Google Fonts CDN, GDPR). Latin subset covers German umlauts too.
import '@fontsource/geist/latin-500.css';
import '@fontsource/niramit/latin-300.css';
import '@fontsource/niramit/latin-400.css';
// Inter is used only inside the LISSA Asset mockup, as in the product's design system.
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import geist500 from '@fontsource/geist/files/geist-latin-500-normal.woff2?url';
import niramit300 from '@fontsource/niramit/files/niramit-latin-300-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
  /** Home page has the header over the accent band and same-page anchors. */
  home?: boolean;
  noindex?: boolean;
}

const { locale = 'en', home = false, noindex = false } = Astro.props;
const t = getContent(locale);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const base = home ? '' : locale === 'en' ? '/' : `/${locale}/`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F4F3EE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={geist500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={niramit300} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Spind" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Mark that JS runs, so reveal animations only hide content when they can show it again. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!--
      Cloudflare Web Analytics (cookieless). TODO: add the token once the domain is live, then uncomment.
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "YOUR_TOKEN"}'></script>
    -->
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header overlay={home} base={base} locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer base={base} locale={locale} />
    <!--
      Grid fit, run before first paint and again by main.ts on resize and font load.
      1. Tile groups [data-fit]: every tile gets enough whole rows for its text (same for the whole group).
      (Vertical sizes follow the Figma design in px; blocks are no longer snapped to whole cells.)
    -->
    <script is:inline>
      window.__gridFit = function () {
        var pr = document.createElement('div');
        pr.style.cssText = 'position:absolute;visibility:hidden;width:var(--cell)';
        document.body.appendChild(pr);
        var c = pr.getBoundingClientRect().width;
        pr.remove();
        if (!c) return;
        var q = function (s, r) { return [].slice.call((r || document).querySelectorAll(s)); };
        q('[data-fit]').forEach(function (g) {
          var tiles = q('.tile', g), extra = 0;
          tiles.forEach(function (t) { t.style.removeProperty('--rows'); });
          tiles.forEach(function (t) {
            var base = parseFloat(getComputedStyle(t).getPropertyValue('--rows')) || 2;
            var need = Math.ceil(t.scrollHeight / c - 0.02);
            if (need - base > extra) extra = need - base;
          });
          if (extra > 0) tiles.forEach(function (t) {
            var base = parseFloat(getComputedStyle(t).getPropertyValue('--rows')) || 2;
            t.style.setProperty('--rows', base + extra);
          });
        });
      };
      window.__gridFit();
    </script>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
