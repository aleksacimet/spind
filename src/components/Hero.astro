---
import Locker3D from './Locker3D.astro';
import { getContent } from '../content/site';

interface Props { locale?: string }
const t = getContent(Astro.props.locale);
---
<!-- Centred hero: a 3D locker (Locker3D), headline, buttons. The dark band ends 3/4 down the locker.
     The blue glow follows the mouse (scripts/main.ts); the locker turns toward the mouse while it is over the stage. -->
<section class="hero" aria-labelledby="hero-title" data-snap data-hero>
  <div class="band space on-accent" aria-hidden="true"><div class="space-glow"></div></div>

  <div class="container hero-inner">
    <div class="hero-stage">
      <Locker3D id="hero" modules={['master', 's24', 'n8']} label={t.hero.lockerLabel} locale={Astro.props.locale} />
    </div>

    <h1 id="hero-title" class="hero-title">{t.hero.title}</h1>
    <p class="hero-intro">{t.hero.intro}</p>

    <div class="hero-actions">
      <a class="btn btn--cta" href="/contact">{t.hero.primary}<span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--secondary" href="#video">{t.hero.secondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Stage height drives the locker size. The 3D camera keeps the same vertical framing at every width
       (see Locker3D): the band ends 3/4 down the locker front, at --f-band of the stage height. */
    --stage-h: calc(var(--container) * 0.48);
    --f-band: 0.72;
    --locker-top: calc(var(--header-h) + var(--u));
    padding-bottom: var(--spacing-gap-general-group-lg);
  }
  /* The hero runs straight into the logo marquee: no line and no spacer under the buttons. */
  :global(main) > .hero { border-bottom: 0; margin-bottom: 0; }

  .band {
    position: absolute;
    inset: 0 0 auto 0;
    height: calc(var(--locker-top) + var(--stage-h) * var(--f-band));
    position: absolute; /* .space supplies the dark background, glow and grain */
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: var(--locker-top);
    padding-inline: var(--inset);
  }

  /* Full viewport width, so the locker can turn without being cut off. */
  .hero-stage {
    width: 100vw;
    height: var(--stage-h);
    margin-inline: calc(50% - 50vw);
  }

  .hero-title { margin-top: var(--spacing-gap-general-object-md); max-width: calc(var(--cell) * 7); text-wrap: wrap; } /* line breaks as in Figma, not balanced */

  .hero-intro { margin-top: var(--spacing-gap-general-object-md); max-width: 600px; color: var(--text-neutral-body); }
  .hero-actions { margin-top: var(--u); display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-gap-general-object-md); }

  @media (max-width: 639px) {
    .hero-actions { width: 100%; }
    .hero-actions .btn { flex: 1 1 100%; }
  }
  @media (min-width: 640px) {
    .hero { --stage-h: calc(var(--container) * 0.47); }
  }
  @media (min-width: 960px) {
    .hero { --stage-h: calc(var(--container) * 0.44); }
    .hero-title { font-size: calc(var(--cell) * 0.44); line-height: round(up, calc(var(--u) * 2.25), 4px); }
  }
  @media (min-width: 1280px) {
    /* Locker about 880 wide on a 900 tall screen (was 640), smaller on short screens so the buttons stay in view. */
    .hero { --stage-h: clamp(400px, calc(100svh - 420px), 520px); --locker-top: 96px; padding-bottom: 32px; }
    .hero-title { font-size: var(--fs-page); line-height: var(--lh-page); letter-spacing: -0.03em; max-width: 776px; margin-top: 24px; }
    .hero-actions { margin-top: 32px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-title, .hero-intro, .hero-actions { animation: hero-up 700ms var(--ease-out) both; }
    .hero-title { animation-delay: 120ms; }
    .hero-intro { animation-delay: 180ms; }
    .hero-actions { animation-delay: 240ms; }
  }
  /* Starts at 0.01, not 0, so the text still counts as painted (LCP). */
  @keyframes hero-up { from { opacity: 0.01; transform: translateY(var(--u)); } to { opacity: 1; transform: none; } }
</style>
