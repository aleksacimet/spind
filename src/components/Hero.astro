---
import LockerDrawing from './LockerDrawing.astro';
import { getContent } from '../content/site';

interface Props { locale?: string }
const t = getContent(Astro.props.locale);
---
<!-- Centred hero, as designed in Figma: locker, headline, buttons. The band ends at the locker's middle.
     The blue glow and the open drawer follow the mouse (see the hero block in scripts/main.ts). -->
<section class="hero" aria-labelledby="hero-title" data-snap data-hero>
  <div class="band space on-accent" aria-hidden="true"><div class="space-glow"></div></div>

  <div class="container hero-inner">
    <div class="hero-locker">
      <LockerDrawing id="hero" modules={['master', 's24', 'n8']} gap={17.5} animate accent={null} label={t.hero.lockerLabel} />
    </div>

    <h1 id="hero-title" class="hero-title">{t.hero.title}</h1>
    <p class="hero-intro">{t.hero.intro}</p>


    <div class="hero-actions">
      <a class="btn btn--cta" href="/contact">{t.hero.primary}<span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--secondary" href="#video">{t.hero.secondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Locker width; 3 modules standing apart (635 x 300 viewBox), height about 0.47 of the width. */
    --lw: calc(var(--cell) * 4);
    --locker-top: var(--cell);
    padding-bottom: var(--spacing-gap-general-group-lg);
  }
  /* The hero runs straight into the logo marquee: no line and no spacer under the buttons. */
  :global(main) > .hero { border-bottom: 0; margin-bottom: 0; }

  .band {
    position: absolute;
    inset: 0 0 auto 0;
    /* The band ends three quarters down the locker, as in Figma (415 at a 382px tall locker). */
    height: calc(var(--locker-top) + var(--lw) * 0.8 * 0.35);
    position: absolute; /* .space supplies the dark background, glow and grain */
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: var(--locker-top);
    padding-inline: var(--inset);
  }
  .hero-locker { width: calc(var(--lw) * 0.8); } /* locker drawn 20% smaller than its slot */

  .hero-title { margin-top: var(--spacing-gap-general-group-lg); max-width: calc(var(--cell) * 7); text-wrap: wrap; } /* line breaks as in Figma, not balanced */


  .hero-intro { margin-top: var(--spacing-gap-general-object-md); max-width: 600px; color: var(--text-neutral-body); }
  .hero-actions { margin-top: var(--u); display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-gap-general-object-md); }

  @media (max-width: 639px) {
    .hero-actions { width: 100%; }
    .hero-actions .btn { flex: 1 1 100%; }
  }
  @media (min-width: 640px) {
    .hero { --lw: calc(var(--cell) * 6); }
  }
  @media (min-width: 960px) {
    .hero { --lw: calc(var(--cell) * 7); }
    .hero-title { font-size: calc(var(--cell) * 0.44); line-height: round(up, calc(var(--u) * 2.25), 4px); }
  }
  @media (min-width: 1280px) {
    /* Figma: header 84 + 48 gap, locker 800 x 382, band 415, gaps 64 / 32, bottom 56 */
    .hero { --lw: 800px; --locker-top: 132px; padding-bottom: 32px; }
    .band { height: calc(132px + 640px * 0.354); } /* ends ~3/4 down the (20% smaller) locker */
    .hero-title { font-size: var(--fs-page); line-height: var(--lh-page); letter-spacing: -0.03em; max-width: 776px; margin-top: var(--spacing-gap-general-section-lg); }
    .hero-actions { margin-top: 32px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-title, .hero-intro, .hero-actions { animation: hero-up 700ms var(--ease-out) both; }
    .hero-title { animation-delay: 120ms; }
    .hero-intro { animation-delay: 180ms; }
    .hero-actions { animation-delay: 240ms; }
  }
  /* Starts at 0.01, not 0, so the text still counts as painted (LCP). */
  @keyframes hero-up { from { opacity: 0.01; transform: translateY(var(--u)); } to { opacity: 1; transform: none; } }
</style>
