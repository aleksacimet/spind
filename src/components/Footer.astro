---
import { getContent, showStories } from '../content/site';
import { href } from '../content/links';

interface Props { base?: string; locale?: string }
const { base = '', locale = 'en' } = Astro.props;
const t = getContent(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const year = new Date().getFullYear();
const to = (h: string) => href(h, base, prefix);
// Footer groups mirror the header menus (Cora-style sitemap footer).
const groups = t.nav.groups.map((g) => ({
  label: g.label,
  items: [
    ...g.columns.flatMap((c) => c.items).filter((it) => g.id !== 'resources' || !['#modules', '#service'].includes(it.href)).filter((it, i, all) => all.findIndex((o) => o.href === it.href) === i),
    ...(g.id === 'resources' && showStories ? [t.nav.customers] : []),
  ],
}));
---
