  <div class="container footer-grid">
    <div class="footer-brand">
      <svg class="mark" viewBox="0 0 100 111" width="100" height="111" role="img" aria-label="Spind by Cimet">
        <rect width="100" height="110.74" fill="var(--mark)" />
        <path d="M50.31 76.99c-3.15 0-5.82-.6-8.04-1.8a12.6 12.6 0 0 1-5.18-5.13c-1.2-2.21-1.92-4.87-2.15-7.98l8.33-.41c.23 1.75.68 3.22 1.34 4.43.66 1.2 1.5 2.1 2.5 2.68 1.01.58 2.21.87 3.61.87 1.24 0 2.29-.17 3.15-.52.89-.35 1.57-.85 2.04-1.51.46-.7.7-1.54.7-2.51 0-1.05-.25-1.98-.76-2.8-.5-.81-1.4-1.55-2.68-2.21-1.24-.66-3.01-1.28-5.3-1.86-2.76-.7-5.05-1.54-6.87-2.5-1.79-.98-3.1-2.22-3.96-3.73-.85-1.52-1.28-3.42-1.28-5.71 0-2.52.54-4.72 1.63-6.58 1.13-1.9 2.74-3.36 4.84-4.37 2.13-1.05 4.71-1.57 7.74-1.57 2.95 0 5.48.54 7.57 1.63a11.02 11.02 0 0 1 4.9 4.72c1.2 2.06 1.9 4.56 2.1 7.51l-8.39.41c-.2-1.43-.56-2.68-1.1-3.73-.55-1.05-1.29-1.84-2.22-2.39-.89-.54-1.96-.81-3.2-.81-1.67 0-3.01.43-4.02 1.28-.97.85-1.46 2.02-1.46 3.5 0 .97.24 1.8.7 2.5.5.7 1.36 1.32 2.56 1.87 1.24.54 2.93 1.1 5.07 1.69 3.14.74 5.63 1.7 7.45 2.91 1.83 1.2 3.13 2.62 3.9 4.25.78 1.63 1.17 3.53 1.17 5.71 0 2.48-.58 4.64-1.75 6.47-1.16 1.78-2.85 3.18-5.07 4.19-2.17 1-4.79 1.51-7.86 1.51Z" fill="var(--mark-ink)" />
        <path fill-rule="evenodd" d="M23.51 48.06h-7.84v47.01h68.66V76.98h-7.84v10.26H23.51V48.06Zm0-24.55v10.26h-7.84V15.67h68.66v45.96h-7.84V23.51H23.51Z" fill="var(--mark-ink)" />
      </svg>
    </div>

    <div class="footer-navs">
    {groups.map((g) => (
      <nav aria-label={g.label}>
        <p class="footer-title label">{g.label}</p>
        <ul role="list" class="footer-links">
          {g.items.map((it) => <li><a href={to(it.href)}>{it.label}</a></li>)}
        </ul>
      </nav>
    ))}

    <nav aria-label={t.footer.legalNav}>
      <p class="footer-title label">{t.footer.legalNav}</p>
      <ul role="list" class="footer-links">
        <li><a href={`${prefix}/impressum`}>{t.footer.impressum}</a></li>
        <li><a href={`${prefix}/privacy`}>{t.footer.privacy}</a></li>
      </ul>
    </nav>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {t.footer.rights}</p>
  </div>
</footer>

<style>
  /* Figma: dark ink footer, yellow mark, light links, large faint "S" (Ink Muted at 10%) in the background. */
  .site-footer { position: relative; overflow: hidden; background: var(--ink); color: var(--paper); padding-top: 100px; font-size: 16px; line-height: 24px; }
  .footer-s { position: absolute; left: 68px; top: -135px; width: 494px; height: 571px; pointer-events: none; }
  .footer-grid { position: relative; display: flex; flex-direction: column; gap: 48px; padding-bottom: 100px; }
  .mark { display: block; width: 100px; height: auto; }
  .footer-links { display: grid; gap: 4px; }
  .footer-links a { color: var(--paper); text-decoration: none; font-weight: 400; }
  .footer-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .footer-navs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 32px; }
  .footer-title { color: var(--line); margin-bottom: 16px; }
  @media (min-width: 640px) { .footer-navs { grid-template-columns: repeat(4, 200px); gap: 40px 24px; } }
  .footer-bottom { position: relative; height: 100px; display: flex; align-items: center; border-top: var(--hair) solid var(--navy-300); color: var(--paper); }
  @media (min-width: 960px) {
    .footer-grid { flex-direction: row; justify-content: space-between; }
  }
</style>
