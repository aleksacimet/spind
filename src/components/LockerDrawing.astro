---
/**
 * Front view of the Spind locker, drawn as SVG so it can animate.
 * Geometry is locked to the page grid: every module is 2 cells wide, the locker is 3 cells tall.
 * Modules: master, s24 (3 x 8), n8 (8 wide), m124 (3 x 4 small, then 4 wide).
 */
type ModuleKey = 'master' | 's24' | 'n8' | 'm124';

interface Props {
  modules?: ModuleKey[];
  /** The drawer shown open (accent). Index is row-major within the module. */
  accent?: { module: ModuleKey; index: number } | null;
  /** Hero entrance animation; the drawer nearest the mouse opens (driven by main.ts). */
  animate?: boolean;
  /** Screen states for the how-it-works story (driven by main.ts via data-state). */
  screen?: { request: string; code: string; open: string; logged: string } | null;
  /** Space between modules in viewBox units (Figma hero: modules stand apart, 22px at 252px module width). */
  gap?: number;
  id: string;
  label: string;
  class?: string;
}

const {
  modules = ['master', 's24', 'n8', 'm124'],
  accent = null, // no drawer is highlighted unless hovered (hero) or part of the story
  animate = false,
  screen = null,
  gap = 0,
  id,
  label,
  class: className = '',
} = Astro.props;

const MW = 200; // module width = 2 cells
const H = 300; // total height = 3 cells
const BH = 288; // body height
const PAD = 6;
const DG = 3;
const totalW = modules.length * MW + (modules.length - 1) * gap;

type Drawer = { x: number; y: number; w: number; h: number; accent: boolean; order: number; n: number; kind: 'small' | 'wide' };

function drawersFor(key: ModuleKey, ox: number): Drawer[] {
  const out: Drawer[] = [];
  if (key === 'master') return out;
  const innerW = MW - PAD * 2;
  const innerH = BH - PAD * 2;
  const rowH = (innerH - DG * 7) / 8;
  const smallW = (innerW - DG * 2) / 3;
  for (let r = 0; r < 8; r++) {
    const y = PAD + r * (rowH + DG);
    const small = key === 's24' || (key === 'm124' && r < 4);
    if (small) for (let c = 0; c < 3; c++) out.push({ x: ox + PAD + c * (smallW + DG), y, w: smallW, h: rowH, accent: false, order: 0, n: 0, kind: 'small' });
    else out.push({ x: ox + PAD, y, w: innerW, h: rowH, accent: false, order: 0, n: 0, kind: 'wide' });
  }
  if (accent && accent.module === key && out[accent.index]) out[accent.index].accent = true;
  return out;
}

const mods = modules.map((key, i) => ({ key, ox: i * (MW + gap), drawers: drawersFor(key, i * (MW + gap)) }));
const all = mods.flatMap((m) => m.drawers);
all.forEach((d, i) => (d.n = i + 1));
// Stagger order: diagonal sweep from top left to bottom right.
[...all].sort((a, b) => a.x + a.y * 1.4 - (b.x + b.y * 1.4)).forEach((d, i) => (d.order = i));

const r1 = (n: number) => Math.round(n * 10) / 10;
const g = (s: string) => `${id}-${s}`;

// QR pattern for the "code" screen state (fixed, decorative).
const qrBits = '1110111100101110101111010001010111011101011011110111001010110111'.split('').map(Number);
const accentDrawer = all.find((d) => d.accent);
---
<svg
  class:list={['locker', className, { 'locker--animate': animate, 'locker--story': !!screen }]}
  viewBox={`0 0 ${totalW} ${H}`}
  role="img"
  aria-label={label}
  style={`--last:${all.length}`}
  data-locker
  data-state={screen ? '0' : undefined}
>
  <defs>
    <linearGradient id={g('accent')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2C74B3" />
      <stop offset="1" stop-color="#2C74B3" />
    </linearGradient>
    <linearGradient id={g('screen')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2A4A6E" />
      <stop offset="1" stop-color="#16263A" />
    </linearGradient>
    <linearGradient id={g('sheen')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.12" />
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
    </linearGradient>
    <linearGradient id={g('body')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF" />
      <stop offset="1" stop-color="#E9EDF2" />
    </linearGradient>
    <filter id={g('glow')} x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="8" /></filter>
    <filter id={g('soft')} x="-10%" y="-400%" width="120%" height="900%"><feGaussianBlur stdDeviation="2.5" /></filter>
  </defs>

  <ellipse class="floor" cx={totalW / 2} cy={BH + 1} rx={totalW * 0.5} ry="2.5" filter={`url(#${g('soft')})`} />
  {mods.map((m) => (
    <g class="mod" data-module={m.key} style={`--m:${mods.indexOf(m)}`}>
      <rect class="body" x={m.ox} y="0" width={MW} height={BH} fill={`url(#${g('body')})`} />
      <rect class="crown" x={m.ox} y="0" width={MW} height="3" />

      {m.key === 'master' && (() => {
        // Figma 105:1457: one central touch screen, a round reader on each side (badge left, QR / camera right).
        const sx = m.ox + 40, sy = 20, sw = 120, sh = 88, cy = sy + sh / 2;
        return (
        <g class="master">
          <rect class="bezel" x={sx - 4} y={sy - 4} width={sw + 8} height={sh + 8} rx="7" />
          <rect class="screen-glow" x={sx} y={sy} width={sw} height={sh} rx="4" filter={`url(#${g('glow')})`} />
          <rect class="screen" x={sx} y={sy} width={sw} height={sh} rx="4" fill={`url(#${g('screen')})`} />
          <rect class="screen-sheen" x={sx} y={sy} width={sw} height={sh / 2} rx="4" fill={`url(#${g('sheen')})`} />
          <clipPath id={g('clip')}><rect x={sx} y={sy} width={sw} height={sh} rx="4" /></clipPath>
          <g clip-path={`url(#${g('clip')})`}>
            <rect class="scanline" x={sx} y={sy} width={sw} height="2" />
            {!screen && (
              <g class="idle">
                <text x={sx + 10} y={sy + 20} class="scr-t">Spind</text>
                <rect class="scr-bar" x={sx + 10} y={sy + 30} width="70" height="4" rx="2" />
                <rect class="scr-bar scr-bar--dim" x={sx + 10} y={sy + 39} width="46" height="4" rx="2" />
                <rect class="scr-cursor" x={sx + 10} y={sy + sh - 26} width="48" height="14" rx="3" />
              </g>
            )}
            {screen && (
              <g class="screens">
                <g class="scr scr-0">
                  <text x={sx + 10} y={sy + 20} class="scr-t">{screen.request}</text>
                  <rect class="scr-bar" x={sx + 10} y={sy + 30} width="86" height="4" rx="2" />
                  <rect class="scr-bar scr-bar--dim" x={sx + 10} y={sy + 39} width="60" height="4" rx="2" />
                  <rect class="scr-cursor" x={sx + 10} y={sy + sh - 26} width="48" height="14" rx="3" />
                </g>
                <g class="scr scr-1">
                  <text x={sx + 10} y={sy + 18} class="scr-t">{screen.code}</text>
                  <rect x={sx + 10} y={sy + 28} width="40" height="40" rx="2" fill="var(--icon-neutral-onsurface)" />
                  {qrBits.map((b, k) => b ? <rect x={sx + 12 + (k % 8) * 4.5} y={sy + 30 + Math.floor(k / 8) * 4.5} width="4.5" height="4.5" fill="#1C2A38" /> : null)}
                  {[0, 1, 2, 3, 4].map((k) => <rect class="pin-dot" x={sx + 58 + k * 11} y={sy + 44} width="7" height="7" rx="1.5" style={`--k:${k}`} />)}
                </g>
                <g class="scr scr-2">
                  <text x={sx + 10} y={sy + 20} class="scr-t">{screen.open}</text>
                  <rect class="scr-bar scr-accent" x={sx + 10} y={sy + 30} width="100" height="4" rx="2" />
                  <text x={sx + 10} y={sy + 72} class="scr-big">08</text>
                </g>
                <g class="scr scr-3">
                  <circle cx={sx + 26} cy={cy} r="14" class="scr-ok" />
                  <path d={`M${sx + 19} ${cy} l5 5 l10 -11`} class="scr-check" />
                  <text x={sx + 48} y={cy + 4} class="scr-t">{screen.logged}</text>
                </g>
              </g>
            )}
          </g>
          {/* Badge reader (left) and QR / camera scanner (right). */}
          <g class="reader">
            <circle class="reader-c" cx={m.ox + 20} cy={cy} r="12" />
            <path class="reader-i" d={`M${m.ox + 17} ${cy - 4} a6 6 0 0 1 0 8 M${m.ox + 20.5} ${cy - 6.5} a10 10 0 0 1 0 13`} />
          </g>
          <g class="reader">
            <circle class="reader-c" cx={m.ox + MW - 20} cy={cy} r="12" />
            <circle class="reader-lens" cx={m.ox + MW - 20} cy={cy} r="4.5" />
          </g>
          <rect class="slot" x={m.ox + 70} y={sy + sh + 14} width="60" height="3" rx="1.5" />
          <rect class="service" x={m.ox + PAD} y="150" width={MW - PAD * 2} height={BH - 150 - PAD} />
          <text class="brand" x={m.ox + 22} y="176">SPIND</text>
          {[0, 1, 2, 3, 4, 5].map((k) => (
            <line class="vent" x1={m.ox + 110} y1={178 + k * 12} x2={m.ox + 182} y2={178 + k * 12} />
          ))}
        </g>
        );
      })()}

      {m.drawers.map((d) => (
        <g
          class:list={['dr', { 'dr--accent': d.accent, 'dr--target': !!screen && d.accent }]}
          style={`--i:${d.order}`}
          data-drawer={d.n}
          data-kind={d.kind}
        >
          <rect class="dr-base" x={r1(d.x)} y={r1(d.y)} width={r1(d.w)} height={r1(d.h)} />
          <rect class="dr-fill" x={r1(d.x)} y={r1(d.y)} width={r1(d.w)} height={r1(d.h)} style={`fill:url(#${g('accent')})`} />
          <line class="handle" x1={r1(d.x + d.w - 14)} y1={r1(d.y + d.h - 5)} x2={r1(d.x + d.w - 5)} y2={r1(d.y + d.h - 5)} />
        </g>
      ))}
    </g>
  ))}
  {screen && accentDrawer && (
    <g class="badge" transform={`translate(${r1(accentDrawer.x + accentDrawer.w - 4)} ${r1(accentDrawer.y - 4)})`}>
      <circle r="9" class="badge-c" />
      <path d="M-4 0 l3 3 l5 -6" class="badge-p" />
    </g>
  )}
</svg>

<style>
  .locker { width: 100%; height: auto; overflow: visible; }
  /* Bodies sit on the module boundary, so neighbouring modules share one 0.5px line. */
  .locker :global(.body) { stroke: var(--surface-neutral-track); stroke-width: var(--hair); vector-effect: non-scaling-stroke; }
  .locker :global(.crown) { fill: var(--illustration-light); opacity: 0.35; }
  .locker :global(.floor) { fill: #0D1015; opacity: 0.18; } /* just a contact shadow: the locker stands on the floor */
  .locker :global(.bezel) { fill: #1E2530; }
  .locker :global(.screen-glow) { fill: #3B82F6; opacity: 0.35; }
  .locker :global(.reader-c) { fill: #1E2530; }
  .locker :global(.reader-i) { fill: none; stroke: var(--illustration-light); stroke-width: var(--stroke); vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .locker :global(.reader-lens) { fill: #2A4A6E; stroke: var(--illustration-light); stroke-width: var(--stroke); vector-effect: non-scaling-stroke; }
  .locker :global(.slot) { fill: #1E2530; opacity: 0.8; }
  .locker :global(.brand) { fill: var(--icon-neutral-default); font-family: var(--font-display); font-weight: 700; font-size: 10px; letter-spacing: 0.2em; }
  .locker :global(.dr-base) { fill: var(--icon-neutral-onsurface); stroke: var(--surface-neutral-track); stroke-width: var(--hair); vector-effect: non-scaling-stroke; }
  .locker :global(.dr-fill) { opacity: 0; transition: opacity 150ms var(--ease); }
  .locker :global(.handle) { stroke: var(--icon-neutral-default); stroke-width: var(--hair); vector-effect: non-scaling-stroke; transition: stroke 150ms var(--ease); }
  .locker :global(.service) { fill: var(--icon-neutral-onsurface); stroke: var(--surface-neutral-track); stroke-width: var(--hair); vector-effect: non-scaling-stroke; }
  .locker :global(.vent) { stroke: var(--surface-neutral-track); stroke-width: var(--hair); vector-effect: non-scaling-stroke; }
  .locker :global(.scanline) { fill: var(--illustration-light); opacity: 0; }

  /* Drawer states */
  .locker :global(.dr) { transform-box: fill-box; transform-origin: center; }
  /* Open drawers change colour only, they keep their size. */
  .locker :global(.dr--accent:not(.dr--target) .dr-fill),
  .locker :global(.dr.is-open .dr-fill) { opacity: 1; }
  .locker :global(.dr--accent:not(.dr--target) .handle),
  .locker :global(.dr.is-open .handle) { stroke: var(--icon-neutral-onsurface); opacity: 0.9; }

  .locker :global(.mod) { transition: opacity var(--dur) var(--ease), transform 700ms var(--ease-out); }

  .locker :global(.dr) { transition: opacity var(--dur-fast) var(--ease); }

  /* Story screens (how it works) */
  .locker :global(.scr) { opacity: 0; transition: opacity 400ms var(--ease); }
  .locker :global(.scr-t) { fill: var(--icon-neutral-onsurface); font-family: var(--font-display); font-weight: 600; font-size: 9px; }
  .locker :global(.scr-big) { fill: var(--icon-neutral-onsurface); font-family: var(--font-display); font-weight: 600; font-size: 28px; }
  .locker :global(.scr-bar) { fill: var(--illustration-light); }
  .locker :global(.scr-bar--dim) { opacity: 0.5; }
  .locker :global(.scr-accent) { fill: #7FB0DC; }
  .locker :global(.scr-cursor) { fill: var(--icon-action-default); }
  .locker :global(.pin-dot) { fill: var(--icon-neutral-onsurface); opacity: 0.25; }
  .locker :global(.scr-ok) { fill: #2F9E6B; }
  .locker :global(.scr-check), .locker :global(.badge-p) { fill: none; stroke: var(--icon-neutral-onsurface); stroke-width: var(--stroke); vector-effect: non-scaling-stroke; }
  .locker :global(.badge) { opacity: 0; transition: opacity 400ms var(--ease); }
  .locker :global(.badge-c) { fill: #2F9E6B; }

  .locker--story[data-state='0'] :global(.scr-0),
  .locker--story[data-state='1'] :global(.scr-1),
  .locker--story[data-state='2'] :global(.scr-2),
  .locker--story[data-state='3'] :global(.scr-3) { opacity: 1; }
  .locker--story[data-state='1'] :global(.pin-dot) { animation: pin 1.6s var(--ease) infinite; animation-delay: calc(var(--k) * 140ms); }
  .locker--story[data-state='2'] :global(.dr--target .dr-fill) { opacity: 1; }
  .locker--story[data-state='2'] :global(.dr--target .handle) { stroke: var(--icon-neutral-onsurface); opacity: 0.9; }
  .locker--story[data-state='3'] :global(.badge) { opacity: 1; }
  .locker--story[data-state='3'] :global(.dr--target .dr-fill) { opacity: 0.25; }
  .locker--story[data-state='1'] :global(.scanline) { opacity: 0.8; animation: scan 1.6s var(--ease) infinite; }

  @media (prefers-reduced-motion: no-preference) {
    .locker :global(.idle .scr-cursor) { animation: idle-pulse 2.4s var(--ease) infinite; }
    .locker :global(.reader-lens) { animation: lens 3.2s var(--ease) infinite; }
  }
  @keyframes idle-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
  @keyframes lens { 0%, 80%, 100% { fill: #2A4A6E; } 88% { fill: #7FB0DC; } }
  @keyframes pin { 0%, 100% { opacity: 0.25; } 40% { opacity: 1; } }
  @keyframes scan { from { transform: translateY(0); } to { transform: translateY(86px); } }

  @media (max-width: 400px) {
    .locker :global(.handle) { display: none; }
  }

  /* Hero entrance: body rises, drawers stagger in, accent drawer pulls out. */
  @media (prefers-reduced-motion: no-preference) {
    .locker--animate { animation: locker-rise 800ms var(--ease-out) both; }
    .locker--animate :global(.dr) { animation: drawer-in 360ms var(--ease) both; animation-delay: calc(250ms + var(--i) * 15ms); }
    .locker--animate :global(.master) { animation: drawer-in 500ms var(--ease) 200ms both; }
    .locker--animate :global(.dr--accent .dr-fill) { animation: fill-in 500ms var(--ease) calc(350ms + var(--last) * 15ms) both; }
  }
  @keyframes locker-rise { from { opacity: 0; transform: translateY(32px); } to { opacity: 1; transform: none; } }
  @keyframes drawer-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fill-in { from { opacity: 0; } to { opacity: 1; } }
</style>
