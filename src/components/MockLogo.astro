---
/**
 * Mock logos for the EXAMPLE social proof (fictional companies). One simple mark plus the name.
 * TODO: replace with real client logos (SVG) once clients approve, see flags.exampleProof.
 */
interface Props { key: string; name: string; class?: string }
const { key, name, class: className = '' } = Astro.props;
const marks: Record<string, string> = {
  'muster-logistik': '<path d="M2 22 L14 6 L26 22 Z"/><path d="M9 22 L14 15 L19 22 Z" fill="var(--logo-bg, #fff)"/>',
  'beispiel-energie': '<path d="M16 2 L6 16 H13 L11 26 L22 11 H15 Z"/>',
  'klinikum-musterstadt': '<path d="M10 3 H18 V10 H25 V18 H18 V25 H10 V18 H3 V10 H10 Z"/>',
  'beispiel-versicherung': '<path d="M14 2 L25 6 V13 C25 20 20 24 14 26 C8 24 3 20 3 13 V6 Z"/>',
  'musterstadt-verkehr': '<circle cx="14" cy="14" r="12"/><rect x="7" y="12" width="14" height="4" fill="var(--logo-bg, #fff)"/>',
  'demo-handel': '<rect x="3" y="3" width="10" height="10"/><rect x="15" y="3" width="10" height="10"/><rect x="3" y="15" width="10" height="10"/><circle cx="20" cy="20" r="5"/>',
  'beispiel-bank': '<path d="M14 2 L26 9 H2 Z"/><rect x="4" y="11" width="4" height="10"/><rect x="12" y="11" width="4" height="10"/><rect x="20" y="11" width="4" height="10"/><rect x="2" y="23" width="24" height="3"/>',
  'muster-stadtwerke': '<path d="M14 2 C20 10 24 14 24 18 A10 10 0 0 1 4 18 C4 14 8 10 14 2 Z"/>',
};
const mark = marks[key] ?? '<rect x="3" y="3" width="22" height="22"/>';
const w = 36 + name.length * 8.6;
---
<svg class:list={['mock-logo', className]} viewBox={`0 0 ${Math.round(w)} 28`} height="28" role="img" aria-label={`${name} logo (example)`}>
  <g fill="currentColor" set:html={mark} />
  <text x="36" y="19.5" fill="currentColor" font-family="Geist, sans-serif" font-weight="500" font-size="15" letter-spacing="-0.2">{name}</text>
</svg>

<style>
  .mock-logo { display: block; height: 28px; width: auto; color: var(--ink-muted-strong); }
</style>
