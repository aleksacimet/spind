---
import IndustryMark from './IndustryMark.astro';
import { getContent } from '../content/site';
import { lp } from '../i18n';
interface Props { slug: string; featured?: boolean; i?: number }
const { slug, featured = false, i = 0 } = Astro.props;
const t = getContent(Astro.currentLocale);
const s = t.proof.stories.find((x) => x.slug === slug)!;
---
<!-- Anonymized story card: industry mark and description instead of a company logo. -->
<article class:list={['story', { 'story--featured': featured }]} data-industry={s.industry} data-reveal="drawer" style={`--d:${i * 80}ms`}>
  <div class="story-top">
    <IndustryMark industryKey={s.industryKey} label={s.company} />
  </div>
  <p class="label">{featured ? `${t.customers.featured} · ${s.industry}` : s.industry}</p>
  <h3><a href={lp(Astro.currentLocale, `/customers/${s.slug}`)}>{s.headline}</a></h3>
  <p class="sum">{s.summary}</p>
  {featured && (
    <dl class="metrics">
      {s.metrics.map((m) => <div><dt>{m.label}</dt><dd class="tabular">{m.value}</dd></div>)}
    </dl>
  )}
  <span class="more" aria-hidden="true">{t.customers.read}<span class="arrow">→</span></span>
</article>

<style>
  .story { position: relative; display: flex; flex-direction: column; gap: var(--spacing-gap-general-object-md); padding: var(--pad-block) var(--inset); background: var(--surface-neutral-default); border-top: var(--hair) solid var(--border-neutral-default); border-left: var(--hair) solid var(--border-neutral-default); transition: background-color var(--dur) var(--ease); }
  .story:hover { background: var(--surface-action-washed); }
  .story--featured :global(.ind-box) { background: color-mix(in srgb, var(--neutral-white) 10%, transparent); }
  .story--featured :global(.ind-box svg) { stroke: var(--surface-cta-default); }
  .story-top { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-gap-general-object-md); margin-bottom: var(--spacing-gap-general-object-md); }
  .story h3 a { text-decoration: none; }
  .story h3 a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .story:hover h3 { color: var(--text-action-default); }
  .sum { color: var(--text-neutral-body); }
  .more { margin-top: auto; padding-top: var(--spacing-padding-container-sm); display: inline-flex; gap: var(--spacing-gap-text-md); font-family: var(--font-display); font-weight: 600; color: var(--text-action-default); }
  .more .arrow { transition: transform var(--dur-fast) var(--ease); }
  .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-gap-general-object-md); padding-top: var(--spacing-padding-container-sm); }
  .metrics div { display: flex; flex-direction: column-reverse; gap: var(--spacing-gap-text-sm); }
  .metrics dd { font-family: var(--font-display); font-weight: 600; font-size: 32px; line-height: 40px; letter-spacing: -0.03em; color: var(--text-neutral-headings); }
  .metrics dt { font-size: 16px; line-height: 24px; color: var(--text-neutral-body); }
  .story--featured { background: var(--surface-neutral-dark); }
  .story--featured :global(.ind-mark), .story--featured h3, .story--featured .metrics dd, .story--featured .more { color: var(--text-neutral-onsurface); }
  .story--featured .label, .story--featured .sum, .story--featured .metrics dt { color: var(--text-neutral-decorative); }
  .story--featured:hover h3 { color: var(--text-neutral-onsurface); }
  .story[hidden] { display: none; }
  @media (min-width: 960px) {
    .story { min-height: 360px; }
    .story--featured h3 { font-size: var(--fs-h3); line-height: var(--lh-h3); max-width: 640px; }
    .metrics dd { font-size: var(--fs-stat); line-height: 48px; }
  }
</style>
