---
import MockLogo from './MockLogo.astro';
import { getContent } from '../content/site';
interface Props { slug: string; featured?: boolean; i?: number }
const { slug, featured = false, i = 0 } = Astro.props;
const t = getContent('en');
const s = t.proof.stories.find((x) => x.slug === slug)!;
const logoName = t.proof.logos.find((l) => l.key === s.logo)?.name ?? s.company;
---
<article class:list={['story', { 'story--featured': featured }]} data-industry={s.industry} data-reveal="drawer" style={`--d:${i * 80}ms`}>
  <div class="story-top">
    <MockLogo key={s.logo} name={logoName} />
  </div>
  <p class="label">{featured ? `${t.customers.featured} · ${s.industry}` : s.industry}</p>
  <h3><a href={`/customers/${s.slug}`}>{s.headline}</a></h3>
  <p class="sum">{s.summary}</p>
  {featured && (
    <dl class="metrics">
      {s.metrics.map((m) => <div><dt>{m.label}</dt><dd class="tabular">{m.value}</dd></div>)}
    </dl>
  )}
  <span class="more" aria-hidden="true">{t.customers.read}<span class="arrow">→</span></span>
</article>

<style>
  .story { position: relative; display: flex; flex-direction: column; gap: var(--spacing-gap-general-object-md); padding: var(--spacing-padding-container-lg); background: var(--surface-neutral-default); border-top: var(--hair) solid var(--border-neutral-default); border-left: var(--hair) solid var(--border-neutral-default); transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease); }
  .story:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); z-index: 2; }
  .story-top { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-gap-general-object-md); margin-bottom: 16px; }
  .story h3 a { text-decoration: none; }
  .story h3 a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .story:hover h3 { color: var(--text-action-default); }
  .sum { color: var(--text-neutral-body); }
  .more { margin-top: auto; padding-top: var(--spacing-padding-container-sm); display: inline-flex; gap: var(--spacing-gap-text-md); font-family: var(--font-display); font-weight: 500; color: var(--text-action-default); }
  .more .arrow { transition: transform var(--dur-fast) var(--ease); }
  .story:hover .more .arrow { transform: translateX(4px); }
  .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-gap-general-object-md); padding-top: var(--spacing-padding-container-sm); }
  .metrics div { display: flex; flex-direction: column-reverse; gap: var(--spacing-gap-text-sm); }
  .metrics dd { font-family: var(--font-display); font-weight: 500; font-size: 32px; line-height: 40px; letter-spacing: -0.03em; color: var(--text-neutral-headings); }
  .metrics dt { font-size: 16px; line-height: 24px; color: var(--text-neutral-body); }
  .story--featured { background: var(--surface-neutral-dark); }
  .story--featured :global(.mock-logo), .story--featured h3, .story--featured .metrics dd, .story--featured .more { color: var(--text-neutral-onsurface); }
  .story--featured .label, .story--featured .sum, .story--featured .metrics dt { color: var(--text-neutral-decorative); }
  .story--featured:hover h3 { color: var(--text-neutral-onsurface); }
  .story[hidden] { display: none; }
  @media (min-width: 960px) {
    .story { min-height: 360px; padding: var(--spacing-padding-container-2xl); }
    .story--featured h3 { font-size: 28px; line-height: 40px; max-width: 640px; }
    .metrics dd { font-size: 48px; line-height: 56px; }
  }
</style>
