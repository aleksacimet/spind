---
import { getContent, contact } from '../content/site';
const t = getContent(Astro.currentLocale);
const f = t.contact.form;
// TODO: form endpoint not decided (Formspree or a Cloudflare Pages Function). Set PUBLIC_FORM_ENDPOINT in .env.
const endpoint = (import.meta.env.PUBLIC_FORM_ENDPOINT ?? '').trim();
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(f.subject)}`;
// Without an endpoint the form falls back to the visitor's email app.
const action = endpoint || mailto;
---
<form
  class="form"
  data-snap
  action={action}
  method="post"
  enctype={endpoint ? undefined : 'text/plain'}
  novalidate
  data-contact-form
  data-endpoint={endpoint}
  data-mailto={mailto}
  data-msg-required={f.errors.required}
  data-msg-email={f.errors.email}
  data-msg-sites={f.errors.sites}
  data-msg-summary={f.errors.summary}
  data-msg-sending={f.sending}
  data-msg-success={f.success}
  data-msg-failure={f.failure}
  data-msg-mailto={f.mailtoNote}
>
  <div class="row two">
    <div class="field">
      <label for="cf-name">{f.name}</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" placeholder={f.placeholders.name} required aria-describedby="cf-name-err" />
      <p class="err" id="cf-name-err" aria-live="polite"></p>
    </div>
    <div class="field">
      <label for="cf-company">{f.company}</label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" placeholder={f.placeholders.company} required aria-describedby="cf-company-err" />
      <p class="err" id="cf-company-err" aria-live="polite"></p>
    </div>
  </div>
  <div class="row two">
    <div class="field">
      <label for="cf-email">{f.email}</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder={f.placeholders.email} required aria-describedby="cf-email-err" />
      <p class="err" id="cf-email-err" aria-live="polite"></p>
    </div>
    <div class="field">
      <label for="cf-sites">{f.sites} <span class="opt">({f.optional})</span></label>
      <div class="counter">
        <input id="cf-sites" name="sites" type="number" inputmode="numeric" min="1" step="1" placeholder={f.placeholders.sites} aria-describedby="cf-sites-err" data-counter />
        <span class="steps">
          <button type="button" class="step" data-step="-1" aria-label={f.fewer} aria-controls="cf-sites"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" style="stroke-width: var(--icon-stroke)" vector-effect="non-scaling-stroke" /></svg></button>
          <button type="button" class="step" data-step="1" aria-label={f.moreSites} aria-controls="cf-sites"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m6 15 6-6 6 6" fill="none" stroke="currentColor" style="stroke-width: var(--icon-stroke)" vector-effect="non-scaling-stroke" /></svg></button>
        </span>
      </div>
      <p class="err" id="cf-sites-err" aria-live="polite"></p>
    </div>
  </div>
  <div class="field field--area">
    <label for="cf-message">{f.message} <span class="opt">({f.optional})</span></label>
    <textarea id="cf-message" name="message" rows="4" placeholder={f.placeholders.message}></textarea>
  </div>
  <!-- Spam trap, hidden from people. -->
  <div class="hp" aria-hidden="true">
    <label for="cf-gotcha">Leave empty</label>
    <input id="cf-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="actions">
    <button class="btn btn--cta" type="submit">{f.submit}<span class="arrow" aria-hidden="true">→</span></button>
    <p class="status" role="status" aria-live="polite" data-form-status></p>
  </div>
</form>

<script>
  // Counter (Figma "Number of sites"): down / up buttons step the number field, never below its min.
  document.querySelectorAll<HTMLInputElement>('[data-counter]').forEach((input) => {
    input.parentElement?.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const min = Number(input.min || 0);
        const cur = input.value === '' ? min - 1 : Number(input.value);
        input.value = String(Math.max(min, cur + Number(btn.dataset.step)));
        input.dispatchEvent(new Event('input', { bubbles: true }));
      });
    });
  });
</script>

<style>
  /* Form on the grid: fields are 2u tall, labels and errors 1u. */
  .form { background: color-mix(in srgb, var(--surface-neutral-dark) 88%, transparent); outline: var(--hair) solid var(--border-neutral-ondark); outline-offset: calc(var(--hair) * -1); backdrop-filter: blur(6px); padding: var(--u); display: grid; }
  .row.two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--u); }
  .field { display: grid; grid-template-rows: var(--u) calc(var(--u) * 2) var(--u); align-content: start; }
  .field--area { grid-template-rows: var(--u) auto; }
  label { font-family: var(--font-body); font-weight: 500; font-size: 15px; line-height: var(--u); color: var(--text-neutral-onsurface); }
  .opt { color: var(--text-neutral-placeholder-ondark); font-weight: 400; }
  input, textarea {
    width: 100%;
    border: var(--hair) solid var(--border-neutral-ondark);
    border-radius: 0;
    background: var(--surface-neutral-input-ondark);
    padding: 0 calc(var(--u) * 0.5);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    height: calc(var(--u) * 2);
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
    -webkit-appearance: none;
    appearance: none;
  }
  textarea { resize: none; height: calc(var(--u) * 4); padding-top: calc(var(--u) * 0.4); line-height: var(--u); }
  /* Dark form (Figma Input field, Theme=Dark) on the dark Contact section. */
  .form { color: var(--text-neutral-ondark); }
  input, textarea { color: var(--text-neutral-ondark); }
  input::placeholder, textarea::placeholder { color: var(--text-neutral-placeholder-ondark); opacity: var(--placeholder-opacity); }
  input:hover, textarea:hover { border-color: var(--border-neutral-strong); }
  input:focus-visible, textarea:focus-visible { outline: var(--border-width-focus) solid var(--border-focus); outline-offset: -2px; border-color: var(--border-focus); background: var(--surface-neutral-input-ondark); }
  input[aria-invalid='true'] { border-color: var(--border-status-error); }
  .err { font-size: 13px; color: var(--border-status-error); font-weight: 500; line-height: var(--u); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0 var(--u); margin-top: var(--u); min-height: calc(var(--u) * 2); }
  .status { font-weight: 500; font-size: 15px; line-height: var(--u); }
  .status.is-error { color: var(--border-status-error); }
  .status.is-ok { color: var(--text-action-ondark); }
  /* Figma: 56px fields and a 112px message box with 16px inner padding */
  input, textarea { padding-left: var(--spacing-padding-container-sm); padding-right: var(--spacing-padding-container-sm); }
  textarea { padding-top: var(--spacing-padding-container-sm); padding-bottom: var(--spacing-padding-container-sm); }
  /* Counter: native spinners hidden, two 40px square steppers inside the field. */
  .counter { position: relative; }
  .counter input { padding-right: 104px; -moz-appearance: textfield; }
  .counter input::-webkit-inner-spin-button, .counter input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .steps { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); display: flex; gap: 8px; }
  .step { display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 0; padding: 0; background: color-mix(in srgb, var(--neutral-white, #fff) 14%, transparent); color: var(--text-neutral-onsurface); cursor: pointer; transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease); }
  .step:hover { background: color-mix(in srgb, var(--neutral-white, #fff) 24%, transparent); }
  .step:active { background: var(--surface-cta-default); color: var(--icon-cta-default); }
  .step:focus-visible { outline: var(--border-width-focus) solid var(--border-focus); outline-offset: 0; }
  @media (max-width: 1279px) { .step { width: 32px; height: 32px; } .counter input { padding-right: 88px; } }
  @media (min-width: 1280px) {
    .form { gap: var(--spacing-gap-general-group-md); padding: var(--spacing-padding-container-xl); }
    .row.two { gap: var(--spacing-gap-general-group-md); }
    .field { grid-template-rows: 24px 56px; gap: var(--spacing-gap-text-sm); } /* error text adds its own row only when shown */
    .err:empty { display: none; }
    .actions { margin-top: 0; }
    .field--area { grid-template-rows: 24px auto; }
    input { height: 56px; }
    textarea { height: 112px; line-height: 28px; }
    label { line-height: 24px; font-size: 16px; }
  }
  @media (max-width: 640px) {
    .row.two { grid-template-columns: 1fr; }
    .err { white-space: normal; }
    .actions .btn { width: 100%; }
  }
</style>
