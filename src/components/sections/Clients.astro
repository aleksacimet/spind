---
import Section from '../Section.astro';
import { getContent } from '../../content/site';
const t = getContent(Astro.props.locale);
const fmt = (n: number) => n.toLocaleString('de-DE');
---
<Section id="clients" title={t.clients.title}>
  <ul class="tiles clients" role="list" data-fit>
    {t.clients.items.map((c, i) => (
      <li class="tile tile--hover client" data-reveal="drawer" style={`--d:${i * 90}ms`}>
        <h3>{c.name}</h3>
        <p><span class="num tabular" data-count={c.count} data-locale="de-DE">{fmt(c.count)}</span><span>{c.suffix}</span></p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .client { grid-column: span 4; --rows: 2; display: flex; flex-direction: column; justify-content: space-between; }
  .num { display: block; font-family: var(--font-display); font-weight: 500; font-size: calc(var(--u) * 2); line-height: calc(var(--u) * 2); color: var(--ink); letter-spacing: -0.03em; }
  @media (min-width: 960px) { .client { grid-column: span 6; } }
</style>
