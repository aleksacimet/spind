---
import Section from '../Section.astro';
import LockerDrawing from '../LockerDrawing.astro';
import { getContent } from '../../content/site';
const t = getContent(Astro.props.locale);
const m = t.modules;
const keys = ['master', 's24', 'n8', 'm124'] as const;
---
<Section id="modules" title={m.title} intro={m.intro} class="section--strong-intro">
  <!-- Full-width locker: every module spans a quarter of the container. -->
  <div class="mod-figure" data-modules data-snap>
    <div class="module-labels" role="group" aria-label={m.title}>
      {keys.map((k) => (
        <button type="button" class="module-label" data-module-btn={k} aria-pressed="false">{m.labels[k]}</button>
      ))}
    </div>
    <div class="mod-locker" data-reveal>
      <LockerDrawing id="modules" label={m.lockerLabel} />
    </div>
  </div>

  <!-- Device fit: white tiles across the full width below the locker. -->
  <ul class="tiles fit" role="list" aria-label={m.fitTitle} data-fit>
    <li class="tile fit-head" data-reveal="drawer">
      <h3>{m.fitTitle}</h3>
      <div class="fit-draw" aria-hidden="true">
        <p class="fit-hint">{m.fitHint}</p>
        {m.fit.map((r) => {
          // Front view in mm: the drawer opening with the device lying on its floor, plus dimension lines.
          const { w, h, dw, dh } = r.draw;
          const dx = (w - dw) / 2;
          const t = 8;
          return (
            <svg class={`draw draw--${r.drawer}`} viewBox="-6 -44 566 150" preserveAspectRatio="xMinYMid meet">
              <rect class="d-open" x="0" y="0" width={w} height={h} pathLength="1" />
              <rect class="d-dev" x={dx} y={h - dh} width={dw} height={dh} />
              <path class="d-dim" d={`M0 -16H${w} M0 ${-16 - t}v${t * 2} M${w} ${-16 - t}v${t * 2} M${w + 16} 0V${h} M${w + 16 - t} 0h${t * 2} M${w + 16 - t} ${h}h${t * 2}`} pathLength="1" />
              <text class="d-t" x={w / 2} y="-26" text-anchor="middle">{w}</text>
              <text class="d-t" x={w + 30} y={h / 2 + 8}>{h}</text>
              <text class="d-t d-t--dev" x={dx + dw / 2} y={h - dh - 12} text-anchor="middle">{dw} × {dh}</text>
            </svg>
          );
        })}
      </div>
    </li>
    {m.fit.map((r, i) => (
      <li class="tile tile--hover fit-item" data-reveal="drawer" data-fit-drawer={r.drawer} style={`--d:${80 + i * 80}ms`}>
        <h3 class="dev">{r.device}</h3>
        <dl class="dims">
          <div><dt class="label">{m.fitHead.size}</dt><dd class="tabular">{r.size}</dd></div>
          <div><dt class="label">{m.fitHead.opening}</dt><dd class="tabular">{r.opening}</dd></div>
        </dl>
        <p class="res">{r.result}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .mod-figure { position: relative; width: 80%; margin-inline: auto; } /* locker and its labels 20% smaller */
  .module-labels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: end;
    /* no extra height: the label text starts exactly --head-pad under the title */
  }
  .module-label {
    justify-self: center;
    padding: 0 0 var(--spacing-padding-container-3xs);
    background: none;
    border: 0;
    border-bottom: var(--hair) solid transparent;
    border-radius: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-subtitle);
    line-height: var(--lh-subtitle);
    color: var(--text-neutral-headings);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .module-label:hover, .module-label[aria-pressed='true'] { color: var(--text-action-default); border-bottom-color: var(--border-action-default); }

  .mod-figure :global(.locker) { filter: none; }
  .mod-figure[data-active] :global(.mod) { opacity: 0.25; }
  .mod-figure[data-active] :global(.mod.is-active) { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .mod-locker :global(.mod) { transform: translateX(calc(var(--m) * 40px + 40px)); opacity: 0; transition: transform 900ms var(--ease-out), opacity 600ms var(--ease); transition-delay: calc(var(--m) * 120ms); }
    :global(.js) .mod-locker.is-visible :global(.mod) { transform: none; opacity: 1; }
    :global(.js) .mod-figure[data-active] .mod-locker.is-visible :global(.mod:not(.is-active)) { opacity: 0.25; transition-delay: 0ms; }
  }

  /* Same gap below the locker as above and below the title (--head-pad). */
  .fit { margin-top: var(--head-pad); }
  .fit-head { grid-column: span 4; --rows: 1; background: var(--surface-neutral-dark); border-color: transparent; box-shadow: none; }
  .fit-head h3 { color: var(--text-neutral-onsurface); }
  .fit-head { display: flex; flex-direction: column; gap: var(--spacing-gap-general-object-md); }

  /* Front-view drawing of the hovered device in its drawer (mm). Lines draw in; nothing else moves. */
  .fit-draw { display: none; position: relative; flex: 1; min-height: 0; }
  .fit-hint { position: absolute; left: 0; bottom: 0; font-size: 14px; line-height: 20px; color: var(--text-neutral-placeholder-ondark); transition: opacity var(--dur-fast) var(--ease); }
  .draw { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; opacity: 0; transition: opacity var(--dur-fast) var(--ease); }
  .d-open { fill: none; stroke: var(--neutral-white); stroke-width: var(--stroke); vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .d-dim { fill: none; stroke: var(--text-neutral-placeholder-ondark); stroke-width: var(--stroke); vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .d-dev { fill: var(--surface-cta-default); opacity: 0; transition: opacity var(--dur) var(--ease); }
  .d-t { fill: var(--text-neutral-ondark); font-family: var(--font-mono); font-weight: 600; font-size: 22px; opacity: 0; transition: opacity var(--dur) var(--ease); }
  .d-t--dev { fill: var(--surface-cta-default); }
  @media (min-width: 640px) { .fit-draw { display: block; } }

  /* Shown by hovering a device card, or a drawer on the locker (main.ts sets data-show on .fit). */
  .fit:is(:has([data-fit-drawer='small']:is(:hover, :focus-visible)), [data-show='small']) .draw--small,
  .fit:is(:has([data-fit-drawer='wide']:is(:hover, :focus-visible)), [data-show='wide']) .draw--wide { opacity: 1; }
  .fit:is(:has([data-fit-drawer]:is(:hover, :focus-visible)), [data-show]) .fit-hint { opacity: 0; }
  .fit:is(:has([data-fit-drawer='small']:is(:hover, :focus-visible)), [data-show='small']) .draw--small :is(.d-open, .d-dim),
  .fit:is(:has([data-fit-drawer='wide']:is(:hover, :focus-visible)), [data-show='wide']) .draw--wide :is(.d-open, .d-dim) { stroke-dashoffset: 0; transition: stroke-dashoffset 700ms var(--ease-out); }
  .fit:is(:has([data-fit-drawer='small']:is(:hover, :focus-visible)), [data-show='small']) .draw--small :is(.d-dev, .d-t),
  .fit:is(:has([data-fit-drawer='wide']:is(:hover, :focus-visible)), [data-show='wide']) .draw--wide :is(.d-dev, .d-t) { opacity: 1; transition-delay: 350ms; }
  /* The hovered card's twin: the device card for the hovered drawer gets the same washed fill. */
  .fit[data-show='small'] [data-fit-drawer='small'], .fit[data-show='wide'] [data-fit-drawer='wide'] { background: var(--surface-action-washed); }
  .mod-locker :global(.dr) { cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .d-open, .d-dim { stroke-dashoffset: 0; } }
  .fit-item { grid-column: span 2; --rows: 2; display: flex; flex-direction: column; }
  /* Two example devices: each takes the remaining half next to the title tile on desktop. */
  .dev { margin-bottom: var(--spacing-gap-text-lg); }
  .dims { display: flex; gap: var(--spacing-gap-general-object-lg); margin-top: var(--spacing-gap-text-md); }
  .dims > div { display: grid; gap: var(--spacing-gap-text-sm); }
  .dims dt { font-size: 12px; line-height: 16px; }
  .dims dd { color: var(--text-neutral-headings); line-height: 24px; font-size: 16px; }
  .res { margin-top: auto; color: var(--text-action-default); font-family: var(--font-display); font-weight: 600; line-height: 24px; }

  @media (min-width: 640px) {
    .fit-head { grid-column: span 8; --rows: 2; }
    .fit-item { grid-column: span 4; }
  }
  @media (min-width: 960px) {
    .fit-head { grid-column: span 4; --rows: 2; }
    .fit-item { grid-column: span 4; }
  }
</style>
