---
import { getContent } from '../../content/site';
const t = getContent(Astro.props.locale);
const p = t.pricing;
---
<!-- Figma "pricing band": pricing is custom, so a short note and a CTA instead of a price. -->
<section id="pricing" class="section pricing" aria-labelledby="pricing-title" data-section="pricing" data-snap>
  <div class="container">
    <div class="band" data-reveal>
      <div class="title-body">
        <h3 id="pricing-title">{p.title}</h3>
        <p>{p.text}</p>
      </div>
      <a class="btn btn--cta" href="#contact">{p.cta}<span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .pricing { padding-top: 0; }
  .band {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-gap-general-object-lg);
    padding: var(--spacing-padding-container-2xl);
    background: var(--surface-neutral-default);
    border: var(--hair) solid var(--border-neutral-default);
  }
  .band h3 { font-size: 28px; line-height: 40px; }
  .band p { color: var(--text-neutral-body); max-width: 600px; }
  @media (min-width: 960px) {
    .band { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
