---
import MockLogo from '../MockLogo.astro';
import DrawerHead from '../DrawerHead.astro';
import { getContent, flags } from '../../content/site';
interface Props { locale?: string; wall?: boolean }
const { locale, wall = false } = Astro.props;
const t = getContent(locale);
const logos = t.proof.logos;
---
<!-- Social proof logos: a constant, infinite horizontal scroll (two identical sets, the second one hidden from screen readers). -->
{flags.exampleProof && (
  <section class:list={['section logos', { 'logos--wall': wall }]} aria-label={t.sectionLabels.logos}>
    <div class="container">
    <DrawerHead label={t.sectionLabels.logos} />
    <div class="marquee">
      <div class="track">
        {[0, 1].map((copy) => (
          <ul role="list" class="set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {logos.map((l) => <li><MockLogo key={l.key} name={l.name} /></li>)}
          </ul>
        ))}
      </div>
    </div>
    </div>
  </section>
)}

<style>
  .marquee { margin-inline: calc(var(--inset) * -1); padding-block: var(--head-pad) var(--spacer); } /* logos scroll rail to rail */
  .marquee { overflow: hidden; }
  .track { display: flex; width: max-content; }
  .set { display: flex; align-items: center; gap: var(--spacing-gap-general-section-lg); padding-right: var(--spacing-padding-section-md); }
  .set li { flex: none; }
  @media (prefers-reduced-motion: no-preference) {
    .track { animation: logos-scroll 40s linear infinite; }
    .marquee:hover .track { animation-play-state: paused; }
  }
  /* Moving one full set to the left lands exactly on the start of the copy, so the loop has no seam. */
  @keyframes logos-scroll { to { transform: translateX(-50%); } }
  /* Without motion: one static, centred set. */
  @media (prefers-reduced-motion: reduce) {
    .track { width: auto; justify-content: center; }
    .set { flex-wrap: wrap; justify-content: center; gap: var(--spacing-gap-general-group-lg) 56px; padding: 0 var(--spacing-padding-container-md); }
    .set[aria-hidden] { display: none; }
  }


  .logos--wall .set { gap: var(--spacing-gap-general-section-xl); padding-right: var(--spacing-padding-section-xl); }
</style>
