---
import Section from '../Section.astro';
import { getContent } from '../../content/site';
const t = getContent(Astro.props.locale);
const s = t.service;
---
<Section id="service" title={s.title} intro={s.intro}>
  <div class="tiles cycle" data-fit data-cycle>
    <div class="tile cycle-head" data-reveal="drawer">
      <h3>{s.lifecycleTitle}</h3>
      <p>{s.lifecycleFooter}</p>
    </div>
    <ol class="cycle-steps" role="list">
      {s.lifecycle.map((step, i) => (
        <li class="tile cycle-step" data-reveal="drawer" style={`--d:${60 + i * 60}ms`}>
          <span class:list={['node', { 'node--accent': i === 2 }]} aria-hidden="true"></span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  .cycle-head { grid-column: span 4; --rows: 2; background: var(--graphite); border-color: transparent; box-shadow: none; }
  .cycle-head h3, .cycle-head p { color: var(--surface); }
  .cycle-steps { display: contents; }
  .cycle-step { grid-column: span 4; --rows: 1; display: grid; grid-template-columns: var(--u) 1fr; column-gap: calc(var(--u) * 0.5); row-gap: 4px; align-content: center; padding-top: 0; padding-bottom: 0; }
  .cycle-step h3 { margin: 0; }
  .cycle-step p { grid-column: 2; }
  .node { grid-row: span 2; align-self: center; width: 11px; height: 11px; background: var(--ink); transform: rotate(45deg); }
  .node--accent { background: var(--accent); }
  /* While visible, the accent diamond walks through the lifecycle (main.ts adds .is-running and .is-on). */
  .node { transition: background-color 450ms var(--ease), transform 450ms var(--ease-out); }
  .cycle-step h3 { transition: color 450ms var(--ease); }
  .cycle.is-running .node { background: var(--ink); }
  .cycle.is-running .is-on .node { background: var(--accent); transform: rotate(45deg) scale(1.3); }
  .cycle.is-running .is-on h3 { color: var(--accent-ink); }

  @media (min-width: 960px) {
    .cycle-head { grid-column: span 2; }
    .cycle-step { grid-column: span 2; --rows: 2; grid-template-columns: 1fr; align-content: start; padding-top: calc(var(--u) - var(--hair)); padding-bottom: var(--u); }
    .node { grid-row: auto; margin-bottom: calc(var(--u) * 0.75); align-self: start; }
    .cycle-step p { grid-column: 1; }
  }
</style>
