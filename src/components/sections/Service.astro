---
import Section from '../Section.astro';
import { getContent } from '../../content/site';
const t = getContent(Astro.currentLocale);
const s = t.service;
---
<Section id="service" title={s.title} intro={s.intro}>
  <div class="tiles cycle" data-fit data-cycle>
    <div class="tile cycle-head" data-reveal="drawer">
      <h3>{s.lifecycleTitle}</h3>
      <p>{s.lifecycleFooter}</p>
    </div>
    <ol class="cycle-steps" role="list">
      {s.lifecycle.map((step, i) => (
        <li class="tile cycle-step" data-reveal="drawer" style={`--d:${60 + i * 60}ms`}>
          <span class:list={['node', { 'node--accent': i === 2 }]} aria-hidden="true"></span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  .cycle-head { grid-column: span 4; --rows: 2; background: var(--surface-neutral-dark); border-color: transparent; box-shadow: none; }
  .cycle-head h3, .cycle-head p { color: var(--text-neutral-onsurface); }
  .cycle-steps { display: contents; }
  .cycle-step { grid-column: span 4; --rows: 1; display: grid; grid-template-columns: var(--spacing-padding-container-sm) 1fr; column-gap: var(--spacing-gap-text-lg); row-gap: var(--spacing-gap-text-sm); align-content: center; padding-top: 0; padding-bottom: 0; }
  .cycle-step h3 { margin: 0; }
  .cycle-step p { grid-column: 2; }
  .node { grid-row: span 2; align-self: center; width: 12px; height: 12px; background: var(--surface-neutral-darkest); transform: rotate(45deg); }
  .node--accent { background: var(--surface-action-default); }
  /* While visible, the accent diamond walks through the lifecycle (main.ts adds .is-running and .is-on). */
  .node { transition: background-color 450ms var(--ease), transform 450ms var(--ease-out); }
  .cycle-step h3 { transition: color 450ms var(--ease); }
  .cycle.is-running .node { background: var(--surface-neutral-darkest); }
  .cycle.is-running .is-on .node { background: var(--surface-action-default); transform: rotate(45deg) scale(1.3); }
  .cycle.is-running .is-on h3 { color: var(--text-action-default); }

  @media (min-width: 960px) {
    .cycle-head { grid-column: span 2; }
    .cycle-step { grid-column: span 2; --rows: 2; grid-template-columns: 1fr; align-content: start; padding-top: var(--pad-block); padding-bottom: var(--pad-block); }
    .node { grid-row: auto; margin-bottom: var(--spacing-gap-general-object-md); align-self: start; }
    .cycle-step p { grid-column: 1; }
  }
</style>
