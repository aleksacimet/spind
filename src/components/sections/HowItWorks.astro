---
import Section from '../Section.astro';
import Locker3D from '../Locker3D.astro';
import { getContent } from '../../content/site';
const t = getContent(Astro.props.locale);
const h = t.how;
---
<!-- Tabs: four steps across the top. The steps play on their own: the open tab's bottom line is a progress bar that fills
     in 5 s, then the next step opens (looping). A click opens a step and plays on from there. Hover only fills a tab.
     Below: one 3D locker (Otto with 8 drawers under the screen) on a darker grey surface; its screen follows the step.
     It turns toward the mouse and a drawer opens while the mouse is over it. The step text is for screen readers. -->
<Section id="how-it-works" title={h.title} intro={h.intro}>
  <div class="story" data-story>
    <div class="story-tabs" role="tablist" aria-label={h.title}>
      {h.steps.map((s, i) => (
        <button
          class="story-tab"
          type="button"
          role="tab"
          id={`story-tab-${i}`}
          aria-controls="story-panel"
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-step={i}
        >
          <span class="tab-num tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="tab-title">{s.title}</span>
          <span class="tab-progress" aria-hidden="true"></span>
        </button>
      ))}
    </div>
    <div class="story-panel" id="story-panel" role="tabpanel" aria-labelledby="story-tab-0">
      {h.steps.map((s, i) => (
        <p class="sr-only" data-copy={i} hidden={i !== 0}>{s.role}: {s.text}</p>
      ))}
      <div class="story-stage">
        <Locker3D id="story" modules={['compact']} label={h.lockerLabel} story={h.screen} storyDrawer={8} locale={Astro.props.locale} />
      </div>
    </div>
  </div>
</Section>

<style>
  .story { display: grid; box-shadow: var(--hair) var(--hair) 0 0 var(--border-neutral-default); }

  /* Tabs: one row of four, hairline frame like the other card grids. */
  .story-tabs { display: grid; grid-template-columns: repeat(2, 1fr); }
  .story-tab {
    position: relative;
    display: flex; align-items: center; gap: var(--spacing-gap-general-object-md, 12px);
    min-height: 80px;
    padding: 0 var(--inset);
    background: var(--surface-neutral-default);
    border: 0;
    border-top: var(--hair) solid var(--border-neutral-default);
    border-left: var(--hair) solid var(--border-neutral-default);
    color: var(--text-neutral-headings);
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition: background-color var(--dur) var(--ease);
  }
  .story-tab:hover { background: var(--surface-action-washed); }
  .story-tab:focus-visible { outline: none; box-shadow: inset 0 0 0 var(--border-width-focus) var(--border-focus); }
  .tab-num { font-family: var(--font-mono); font-weight: 600; font-size: 13px; line-height: 16px; letter-spacing: 0.08em; color: var(--text-neutral-decorative); transition: color var(--dur) var(--ease); }
  .tab-title { font-family: var(--font-display); font-weight: 600; font-size: 18px; line-height: 24px; transition: color var(--dur) var(--ease); }
  .story-tab[aria-selected='true'] .tab-num,
  .story-tab[aria-selected='true'] .tab-title { color: var(--text-action-default); }

  /* Opened tab: its bottom line is the step's progress bar. A pale blue track, the blue fill runs left to right in
     --step-time, then main.ts opens the next step. Without motion (or before JS) the line is simply full. */
  .story { --step-time: 5s; }
  .tab-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--surface-action-washed); opacity: 0; overflow: hidden; }
  .tab-progress::after { content: ''; position: absolute; inset: 0; background: var(--surface-action-default); transform-origin: left; }
  .story-tab[aria-selected='true'] .tab-progress { opacity: 1; }
  :global(.story.is-playing) .story-tab[aria-selected='true'] .tab-progress::after { animation: tab-fill var(--step-time) linear both; }
  :global(.story.is-paused) .story-tab[aria-selected='true'] .tab-progress::after { animation-play-state: paused; }
  @keyframes tab-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* Panel: one locker on a darker grey surface (Ice/200, a studio backdrop for the white locker), full width under
     the tabs. The stage height sets the locker size (Locker3D keeps the same vertical framing at every width). */
  .story-panel { border-top: var(--hair) solid var(--border-neutral-default); }
  .story-stage {
    background: var(--neutral-200);
    border-left: var(--hair) solid var(--border-neutral-default);
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 640px) { .story-stage { aspect-ratio: 16 / 9; } }
  @media (min-width: 960px) {
    .story-tabs { grid-template-columns: repeat(4, 1fr); }
    .story-stage { aspect-ratio: auto; height: 460px; }
  }
  @media (min-width: 1280px) { .story-stage { height: 560px; } }
</style>
