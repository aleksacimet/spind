---
import Section from '../Section.astro';
import LockerDrawing from '../LockerDrawing.astro';
import { getContent } from '../../content/site';
const t = getContent(Astro.props.locale);
const h = t.how;
---
<!-- Timed tabs: four tabs across the top, each with a progress line that fills over 5s, then the next tab opens.
     Below: the active step's text on the left, the locker on the dark surface on the right. Not tied to scrolling;
     clicking a tab opens it and restarts its 5s. -->
<Section id="how-it-works" title={h.title} intro={h.intro}>
  <div class="story" data-story style="--step-dur: 5000ms">
    <div class="story-tabs" role="tablist" aria-label={h.title}>
      {h.steps.map((s, i) => (
        <button
          class="story-tab"
          type="button"
          role="tab"
          id={`story-tab-${i}`}
          aria-controls="story-panel"
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-step={i}
        >
          <span class="tab-num tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="tab-title">{s.title}</span>
          <span class="tab-progress" aria-hidden="true"></span>
        </button>
      ))}
    </div>
    <div class="story-panel" id="story-panel" role="tabpanel" aria-labelledby="story-tab-0">
      <div class="story-copy">
        {h.steps.map((s, i) => (
          <div class="step-copy" data-copy={i} hidden={i !== 0}>
            <span class="step-role">{s.role}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
      <div class="story-stage space" data-hero>
        <div class="space-glow" aria-hidden="true"></div>
        <div class="stage-inner">
          <LockerDrawing
            id="story"
            modules={['master', 's24']}
            accent={{ module: 's24', index: 7 }}
            screen={h.screen}
            label={h.lockerLabel}
          />
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .story { display: grid; box-shadow: var(--hair) var(--hair) 0 0 var(--border-neutral-default); }

  /* Tabs: one row of four, hairline frame like the other card grids. */
  .story-tabs { display: grid; grid-template-columns: repeat(2, 1fr); }
  .story-tab {
    position: relative;
    display: flex; align-items: center; gap: var(--spacing-gap-general-object-md, 12px);
    min-height: 80px;
    padding: 0 var(--inset);
    background: var(--surface-neutral-default);
    border: 0;
    border-top: var(--hair) solid var(--border-neutral-default);
    border-left: var(--hair) solid var(--border-neutral-default);
    color: var(--text-neutral-headings);
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition: background-color var(--dur) var(--ease);
  }
  .story-tab:hover { background: var(--surface-action-washed); }
  .story-tab:focus-visible { outline: none; box-shadow: inset 0 0 0 var(--border-width-focus) var(--border-focus); }
  .tab-num { font-family: var(--font-mono); font-weight: 600; font-size: 13px; line-height: 16px; letter-spacing: 0.08em; color: var(--text-neutral-decorative); transition: color var(--dur) var(--ease); }
  .tab-title { font-family: var(--font-display); font-weight: 600; font-size: 18px; line-height: 24px; transition: color var(--dur) var(--ease); }
  .story-tab[aria-selected='true'] .tab-num,
  .story-tab[aria-selected='true'] .tab-title { color: var(--text-action-default); }

  /* Progress line along the bottom of the active tab: fills left to right over --step-dur. */
  .tab-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--surface-action-default); transform: scaleX(0); transform-origin: left center; }
  .story-tab[aria-selected='true'] .tab-progress { transform: scaleX(1); }
  @media (prefers-reduced-motion: no-preference) {
    .story.is-playing .story-tab[aria-selected='true'] .tab-progress { animation: tab-fill var(--step-dur) linear forwards; }
  }
  @keyframes tab-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* Panel: text on the left, locker on the dark surface on the right. */
  .story-panel { display: grid; border-top: var(--hair) solid var(--border-neutral-default); }
  .story-copy { display: grid; align-content: center; padding: var(--pad-block) var(--inset); background: var(--surface-neutral-default); border-left: var(--hair) solid var(--border-neutral-default); }
  .step-copy { display: grid; gap: var(--spacing-gap-text-sm); max-width: 440px; }
  .step-copy[hidden] { display: none; }
  .step-role { font-family: var(--font-mono); font-weight: 600; font-size: 13px; line-height: 16px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-action-default); margin-bottom: var(--spacing-gap-text-md, 8px); }
  .step-copy h3 { font-size: 32px; line-height: 40px; color: var(--text-neutral-headings); }
  .step-copy p { font-weight: 400; font-size: 18px; line-height: 1.6; color: var(--text-neutral-body); }
  @media (prefers-reduced-motion: no-preference) {
    .step-copy:not([hidden]) { animation: copy-in 500ms var(--ease-out); }
  }
  @keyframes copy-in { from { opacity: 0; } to { opacity: 1; } }

  .story-stage { display: flex; align-items: center; justify-content: center; min-height: 360px; padding: var(--pad-block) var(--inset); }
  .stage-inner { width: 80%; max-width: 400px; }

  @media (min-width: 960px) {
    .story-tabs { grid-template-columns: repeat(4, 1fr); }
    .story-panel { grid-template-columns: 5fr 7fr; }
    .story-stage { min-height: 520px; }
  }
</style>
