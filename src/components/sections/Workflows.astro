---
import Section from '../Section.astro';
import { getContent } from '../../content/site';
const t = getContent(Astro.props.locale);
const w = t.workflows;
---
<Section id="workflows" title={w.title} intro={w.intro}>
  <ul class="tiles wf" role="list" data-fit>
    {w.cards.map((c, i) => (
      <li class="tile wf-card" data-reveal="drawer" style={`--d:${(i % 3) * 90 + Math.floor(i / 3) * 120}ms`}>
        <div class="title-body">
          <h3><a class="wf-link" href={`/use-cases/${c.slug}`}>{c.title}</a></h3>
          <p>{c.text}</p>
        </div>
        <span class="arrow" aria-hidden="true">→</span>
      </li>
    ))}
  </ul>

  <div class="compare">
    <div class="panel panel--today" data-reveal="drawer">
      <div class="panel-head"><h3 class="panel-title">{w.today}</h3></div>
      <ol class="rows" role="list">
        {w.compare.map(([today]) => (
          <li class="row">
            <svg class="ic" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 1.5C6.15 1.5 1.5 6.15 1.5 12S6.15 22.5 12 22.5 22.5 17.85 22.5 12 17.85 1.5 12 1.5Zm4.05 15.75L12 13.2l-4.05 4.05-1.2-1.2L10.8 12 6.75 7.95l1.2-1.2L12 10.8l4.05-4.05 1.2 1.2L13.2 12l4.05 4.05-1.2 1.2Z" fill="var(--icon-status-error)" /></svg>
            <span class="txt"><s>{today}</s></span>
          </li>
        ))}
      </ol>
    </div>
    <div class="panel panel--spind on-accent" data-reveal="drawer" style="--d:150ms">
      <div class="panel-head"><h3 class="panel-title">{w.withLead} {w.withBrand}</h3></div>
      <ol class="rows" role="list">
        {w.compare.map(([, spind], i) => (
          <li class="row" style={`--k:${i}`}>
            <svg class="ic" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M11.49 21.75c.29.16.66.16.96 0 8.01-4.3 8.58-12.71 8.57-15.1a1 1 0 0 0-.6-.9l-8.05-3.57a1 1 0 0 0-.81 0L3.57 5.75a1 1 0 0 0-.6.89c-.03 2.38.45 10.8 8.52 15.11ZM8.67 10.29l2.3 2.3 4.29-4.3 1.41 1.42-5.7 5.7-3.71-3.7 1.41-1.42Z" fill="var(--icon-neutral-ondark)" /></svg>
            <span class="txt">{spind}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Section>

<style>
  .wf .tile { grid-column: span 4; --rows: 2; }
  /* Figma "Use case card": title + body, arrow on the right, washed blue on hover. */
  .wf .tile { display: flex; align-items: flex-start; gap: var(--spacing-gap-general-object-lg); transition: background-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease); }
  .wf .title-body { flex: 1; }
  .wf .tile h3 { margin: 0; }
  .wf-link { text-decoration: none; }
  .wf-link::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .wf .arrow { font-family: var(--font-display); font-weight: 500; font-size: 20px; line-height: 28px; color: var(--text-action-default); transition: transform var(--dur-fast) var(--ease); }
  .wf .tile:hover { background: var(--surface-action-washed); box-shadow: inset 0 0 0 var(--hair) var(--border-action-default); }
  .wf .tile:hover .arrow { transform: translateX(4px); }
  @media (min-width: 640px) { .wf .tile { grid-column: span 4; } }
  @media (min-width: 960px) { .wf .tile { grid-column: span 4; } }

  /* Comparison: two panels (Figma): 96px head, 56px rows with an icon. */
  .compare {
    margin-top: var(--cell);
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--cell));
    row-gap: var(--u);
  }
  .panel { grid-column: 1 / -1; }
  .panel-head { height: 96px; padding: var(--spacing-padding-container-sm) var(--spacing-padding-container-lg) var(--spacing-padding-container-3xl); }
  .panel-title { font-size: calc(var(--fs-subtitle) * 1.4); line-height: 40px; }
  .rows { display: grid; grid-auto-rows: 76px; }
  .row { display: flex; align-items: center; gap: var(--spacing-gap-general-object-md); padding: 0 var(--spacing-padding-container-lg); }
  .ic { flex: none; width: 20px; height: 20px; margin: 2px; } /* 20px icon in a 24px box */
  .panel--today { background: var(--surface-neutral-default); outline: var(--hair) solid var(--border-neutral-default); outline-offset: calc(var(--hair) * -1); }
  .panel--today .panel-title, .panel--today .txt { color: var(--text-neutral-body); }
  .panel--today s { text-decoration-thickness: var(--hair); }
  .panel--spind { background: var(--surface-action-default); color: var(--text-neutral-onsurface); }
  .panel--spind .panel-title { color: var(--text-neutral-onsurface); }
  .panel--spind .row { gap: var(--spacing-gap-text-md); padding: 0 var(--spacing-padding-container-xl); }
  .panel--spind .txt { font-family: var(--font-display); font-weight: 500; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .panel--spind .row { opacity: 0; transform: translateX(-12px); transition: opacity 500ms var(--ease), transform 600ms var(--ease-out); transition-delay: calc(500ms + var(--k) * 110ms); }
    :global(.js) .panel--spind.is-visible .row { opacity: 1; transform: none; }
  }

  @media (min-width: 960px) {
    .compare { row-gap: 0; }
    .panel--today { grid-column: 1 / span 6; }
    .panel--spind { grid-column: 7 / span 6; }
  }
  @media (min-width: 1280px) { .panel-title { font-size: 28px; } }
</style>
