---
import Section from '../Section.astro';
import LissaMock from '../LissaMock.astro';
import { getContent } from '../../content/site';
const t = getContent(Astro.currentLocale);
const p = t.platform;
---
<Section id="platform" title={p.title} intro={p.intro} class="section--strong-intro">
  <div class="mock-wrap" data-reveal data-snap>
    <LissaMock label={p.mockLabel} />
  </div>
</Section>

<style>
  .mock-wrap { margin-bottom: 0; }
  /* Rail to rail: the rails and the panel line frame the mock, so it drops its own frame. */
  .mock-wrap :global(.mock) { outline: 0; }
</style>
