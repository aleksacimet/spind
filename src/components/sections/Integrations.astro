---
import Section from '../Section.astro';
import LissaMark from '../LissaMark.astro';
import { getContent } from '../../content/site';
import { integrationIcons } from '../../content/icons';
const t = getContent(Astro.props.locale);
const n = t.integrations;
---
<!-- Integrations (Cora shows this as its own slide, so do we): a dark hub with live connections to four systems. -->
<Section id="integrations" title={n.title} intro={n.intro} class="section--strong-intro">
  <div class="intg">
    <div class="hub glow-band on-accent" data-reveal="drawer" data-hero>
      <div class="space-glow" aria-hidden="true"></div>
      <div class="hub-mark" aria-hidden="true">
        <svg viewBox="0 0 120 120" width="120" height="120">
          <circle class="ring ring--3" cx="60" cy="60" r="56" />
          <circle class="ring ring--2" cx="60" cy="60" r="42" />
          <circle class="ring ring--1" cx="60" cy="60" r="28" />
          {/* Spind mark (same S as the favicon), yellow version. */}
          <svg class="hub-logo" x="42" y="40" width="36" height="40" viewBox="0 0 1238 1371"><rect width="1238" height="1371" fill="#FFD369"/><path d="M622.861 953.144C583.923 953.144 550.754 945.693 523.353 930.791C495.952 915.889 474.56 894.737 459.177 867.336C444.275 839.935 435.381 807.006 432.497 768.549L535.611 763.501C538.495 785.133 544.024 803.401 552.196 818.303C560.368 833.205 570.703 844.262 583.202 851.473C595.701 858.683 610.603 862.289 627.909 862.289C643.292 862.289 656.271 860.125 666.847 855.799C677.904 851.473 686.316 845.223 692.085 837.051C697.853 828.398 700.738 818.063 700.738 806.045C700.738 793.065 697.613 781.528 691.364 771.433C685.114 761.338 674.058 752.204 658.194 744.032C642.811 735.86 620.938 728.168 592.576 720.958C558.445 712.305 530.083 701.969 507.489 689.951C485.376 677.933 469.032 662.55 458.456 643.802C447.88 625.054 442.592 601.499 442.592 573.137C442.592 541.89 449.322 514.73 462.782 491.655C476.723 468.1 496.673 450.073 522.632 437.574C549.071 424.595 581.039 418.105 618.535 418.105C655.069 418.105 686.316 424.836 712.275 438.296C738.234 451.756 758.424 471.225 772.845 496.703C787.748 522.181 796.4 553.187 798.804 589.722L694.969 594.769C692.565 576.983 687.999 561.6 681.269 548.62C674.538 535.641 665.405 525.786 653.868 519.056C642.811 512.326 629.591 508.961 614.208 508.961C593.538 508.961 576.953 514.249 564.454 524.825C552.436 535.401 546.427 549.822 546.427 568.089C546.427 580.107 549.311 590.443 555.08 599.096C561.329 607.749 571.905 615.44 586.807 622.17C602.19 628.9 623.102 635.871 649.541 643.081C688.479 652.215 719.245 664.233 741.839 679.135C764.433 694.037 780.537 711.584 790.151 731.774C799.765 751.964 804.573 775.519 804.573 802.439C804.573 833.205 797.362 859.885 782.94 882.479C768.519 904.592 747.608 921.898 720.207 934.396C693.286 946.895 660.838 953.144 622.861 953.144Z" fill="#222831"/><path d="M291 595H194V1177H1044V953H947V1080H291V595ZM291 291V418H194V194H1044V763H947V291H291Z" fill-rule="evenodd" clip-rule="evenodd" fill="#222831"/></svg>
          {[0, 1, 2, 3].map((k) => <circle class="orbit" r="3" style={`--k:${k}`} cx="60" cy="4" />)}
        </svg>
      </div>
      <div class="title-body">
        <h3>{n.hubTitle}</h3>
        <p>{n.hubText}</p>
      </div>
      <p class="hub-note">{n.note}</p>
      <a class="btn btn--cta hub-btn" href="/integrations">{n.more}<span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <ul class="intg-list" role="list">
      {n.items.map((it, i) => ('logo' in it && it.logo ? (
        <li class="intg-cell">
          <a class="tile intg-item lissa-card" href={n.lissaHref} data-reveal="drawer" data-spot style={`--d:${120 + i * 90}ms`}>
            <LissaMark />
            <div class="title-body">
              <h3>{it.title}</h3>
              <p>{it.text}</p>
              <span class="read-full">{n.readFull}</span>
            </div>
            <span class="pulse" aria-hidden="true"></span>
          </a>
        </li>
      ) : (
        <li class="tile intg-item" data-reveal="drawer" data-spot style={`--d:${120 + i * 90}ms`}>
          <span class="intg-icon" aria-hidden="true"><svg class="line-icon" viewBox="0 0 22 22" width="24" height="24"><path d={integrationIcons[it.key]} pathLength="1" /></svg></span>
          <div class="title-body">
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </div>
          <span class="pulse" aria-hidden="true"></span>
        </li>
      )))}
    </ul>
  </div>
</Section>

<style>
  .intg { display: grid; gap: var(--spacing-gap-general-group-md); }
  .hub { display: flex; flex-direction: column; gap: var(--spacing-gap-general-object-lg); padding: var(--pad-block) var(--inset); min-height: 360px; }
  .hub h3 { color: var(--text-neutral-onsurface); }
  .hub p { color: var(--text-neutral-ondark); max-width: 360px; }
  .hub .hub-note { margin-top: auto; font-size: 16px; line-height: 24px; color: var(--text-neutral-decorative); }
  .hub-btn { align-self: flex-start; }
  .hub-mark svg { overflow: visible; }
  .ring { fill: none; stroke: color-mix(in srgb, var(--neutral-white) 18%, transparent); stroke-width: var(--stroke); vector-effect: non-scaling-stroke; }
  .orbit { fill: var(--surface-cta-default); transform-origin: 60px 60px; transform: rotate(calc(var(--k) * 90deg)); }

  .intg-list { display: grid; grid-template-columns: 1fr; box-shadow: var(--hair) var(--hair) 0 0 var(--border-neutral-default); }
  .intg-item { grid-row: auto; min-height: 0; display: flex; gap: var(--spacing-gap-general-object-lg); align-items: flex-start; padding: var(--pad-block) var(--inset); transition: background-color var(--dur) var(--ease), clip-path 750ms var(--ease-out) var(--d, 0ms); }
  .intg-item h3 { margin: 0; transition: color var(--dur-fast) var(--ease); }
  /* Title and subtitle read as one text block: subtitle 16px at 1.6 line height, 4px under the title. */
  .intg-item p, .hub .title-body p { font-size: 16px; line-height: 1.6; }
  .intg-icon { flex: none; display: grid; place-items: center; width: 48px; height: 48px; background: var(--surface-action-washed); transition: background-color var(--dur) var(--ease); }
  .intg-icon svg { stroke: var(--icon-action-strong); transition: stroke var(--dur-fast) var(--ease); }
  /* Live dot: the connection is up. */
  .pulse { position: absolute; top: var(--pad-block); right: var(--inset); width: 8px; height: 8px; border-radius: 50%; background: #2F9E6B; }
  .intg-item:hover { background: var(--surface-action-washed); }
  .intg-item:hover h3 { color: var(--text-action-default); }
  .intg-item:hover .intg-icon { background: var(--surface-action-default); }
  .intg-item:hover .intg-icon svg { stroke: var(--icon-neutral-onsurface); }
  .intg-item:hover .intg-icon path { animation: icon-draw 700ms var(--ease-out); }

  @media (prefers-reduced-motion: no-preference) {
    .ring--1 { animation: ring 3s var(--ease) infinite; }
    .ring--2 { animation: ring 3s var(--ease) 400ms infinite; }
    .ring--3 { animation: ring 3s var(--ease) 800ms infinite; }
    .orbit { animation: orbit 12s linear infinite; }
    .pulse::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: inherit; animation: ping 2.4s var(--ease-out) infinite; animation-delay: var(--d, 0ms); }
  }
  @keyframes ring { 0%, 100% { stroke: color-mix(in srgb, var(--neutral-white) 12%, transparent); } 50% { stroke: color-mix(in srgb, var(--neutral-white) 34%, transparent); } }
  @keyframes orbit { from { transform: rotate(calc(var(--k) * 90deg)); } to { transform: rotate(calc(var(--k) * 90deg + 360deg)); } }
  @keyframes ping { 0% { transform: scale(1); opacity: 0.6; } 80%, 100% { transform: scale(3); opacity: 0; } }

  /* LISSA card is a link: whole card clickable, "Read full" (underlined) fades in on hover; its space is kept so nothing moves. */
  .intg-cell { display: grid; }
  .lissa-card { color: inherit; text-decoration: none; cursor: pointer; }
  .lissa-card:focus-visible { outline: var(--border-width-focus) solid var(--border-focus); outline-offset: calc(var(--border-width-focus) * -1); }
  .read-full {
    display: inline-block; margin-top: var(--spacing-gap-text-md);
    font-family: var(--font-display); font-weight: 600; font-size: 16px; line-height: 24px;
    color: var(--text-action-default); text-decoration: underline; text-decoration-thickness: var(--hair); text-underline-offset: 4px;
    opacity: 0; transition: opacity var(--dur-fast) var(--ease);
  }
  .lissa-card:is(:hover, :focus-visible) .read-full { opacity: 1; }
  .lissa-card:is(:hover, :focus-visible) { background: var(--surface-action-washed); }
  .lissa-card:is(:hover, :focus-visible) h3 { color: var(--text-action-default); }
  @media (hover: none) { .read-full { opacity: 1; } }

  @media (min-width: 640px) { .intg-list { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 960px) {
    .intg { grid-template-columns: 5fr 7fr; gap: 0; }
    .intg-item { flex-direction: column; } /* narrow desktop: icon above the text */
  }
  @media (min-width: 1280px) {
    .intg-item { flex-direction: row; } /* compact cards: icon beside the text, height follows the content */
  }
</style>
