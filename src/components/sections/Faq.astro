---
import { getContent } from '../../content/site';
interface Props { locale?: string; title?: string; only?: number[]; id?: string }
const { locale, title, only, id = 'faq' } = Astro.props;
const t = getContent(locale);
const f = { title: title ?? t.faq.title, items: only ? only.map((i) => t.faq.items[i]) : t.faq.items };
---
<!-- Figma: heading on the left (400px), one column of questions on the right (gap 104). -->
<section id={id} class="section faq-section" aria-labelledby={`${id}-title`} data-section={id}>
  <div class="container faq-grid">
    <h2 id={`${id}-title`} data-split>{f.title}</h2>
    <div class="faq-list">
      {f.items.map((item, i) => (
        <details class="qa" data-reveal style={`--d:${i * 50}ms`}>
          <summary>
            <span class="q">{item.q}</span>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <div class="a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section { padding-block: 48px; }
  .faq-grid { display: flex; flex-direction: column; gap: 32px; }
  .faq-list { flex: 1; }
  .qa { background: var(--surface); box-shadow: inset 0 var(--hair) 0 var(--line); }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
    padding: 0 24px;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-subtitle);
    line-height: 28px;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .q { color: var(--accent-ink); }
  .pm { position: relative; flex: none; width: 28px; height: 28px; background: var(--surface); outline: var(--hair) solid var(--line); outline-offset: calc(var(--hair) * -1); transition: background-color var(--dur-fast) var(--ease); }
  .pm::before { content: '+'; position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-display); font-weight: 500; font-size: 16px; line-height: 20px; color: var(--ink); transition: transform var(--dur) var(--ease-out), color var(--dur-fast) var(--ease); }
  .qa[open] .pm { background: var(--accent); outline-color: transparent; }
  .qa[open] .pm::before { color: #fff; transform: rotate(45deg); }
  .a { color: var(--ink-muted); padding: 0 24px 24px; max-width: 60ch; }
  @media (prefers-reduced-motion: no-preference) {
    .qa[open] .a { animation: qa-open 500ms var(--ease-out); }
  }
  @keyframes qa-open { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @media (min-width: 960px) {
    .faq-grid { flex-direction: row; gap: 104px; }
    .faq-grid h2 { width: 400px; flex: none; }
  }
</style>
