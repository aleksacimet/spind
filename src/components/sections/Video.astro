---
import Section from '../Section.astro';
import { getContent } from '../../content/site';
const t = getContent(Astro.currentLocale);
const v = t.video;
---
<!-- Figma "video": 16:9 player over all 12 columns. Until a video URL is set in site.ts it shows the placeholder. -->
<Section id="video" title={v.title} intro={v.intro}>
  <div class="player" data-reveal>
    {v.src ? (
      <video controls preload="none" playsinline poster={v.poster || undefined} aria-label={v.title}>
        <source src={v.src} type="video/mp4" />
      </video>
    ) : (
      <div class="placeholder">
        {v.poster && <img class="poster" src={v.poster} alt="" width="1920" height="1080" loading="lazy" decoding="async" />}
        <button class="play" type="button" aria-label={v.play} disabled>
          <svg viewBox="0 0 96 96" width="100%" height="100%" aria-hidden="true"><path d="M64 48 40 64.02V31.98Z" /></svg>
        </button>
        {v.placeholder && <p class="label">{v.placeholder}</p>}
      </div>
    )}
  </div>
</Section>

<style>
  /* Pointer cursor over the whole video, even while there is nothing to play yet. */
  .player, .player * { cursor: pointer; }
  .player { position: relative; aspect-ratio: 16 / 9; background: var(--surface-neutral-dark); overflow: hidden; }
  .player video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Figma 86:227: the render sits under a dark ice wash so the yellow play button carries the frame. */
  .placeholder::before { content: ''; position: absolute; inset: 0; z-index: 1; background: color-mix(in srgb, var(--ice-1000) 72%, transparent); }
  .placeholder > :not(.poster) { position: relative; z-index: 2; }
  .placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--spacing-gap-general-object-md); }
  .play {
    padding: 0;
    display: grid; place-items: center;
    width: 128px; height: 128px;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease);
    border: 0; border-radius: var(--scale-max);
    background: var(--surface-cta-default);
    color: var(--icon-cta-default);
  }
  .play svg { fill: currentColor; }
  .player:hover .play { box-shadow: 0 0 32px color-mix(in srgb, var(--surface-cta-default) 45%, transparent); }
  @media (max-width: 639px) { .play { width: 88px; height: 88px; } }
  .placeholder .label { color: var(--text-neutral-decorative); }
</style>
