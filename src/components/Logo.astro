---
import { LOGO_PATHS, LOGO_VIEWBOX, LOGO_W, LOGO_H } from './logo-path';

interface Props {
  /** Visual height in px. Width follows the aspect ratio (472 x 197). */
  height?: number;
  class?: string;
  /** Accessible name. Pass "" when visible text next to it already says Spind. */
  title?: string;
}
const { height = 40, class: className = '', title = 'Spind' } = Astro.props;
const width = Math.round((height * LOGO_W) / LOGO_H);
---
<svg
  class:list={['logo', className]}
  viewBox={LOGO_VIEWBOX}
  width={width}
  height={height}
  fill="currentColor"
  role={title ? 'img' : undefined}
  aria-label={title || undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {LOGO_PATHS.map((p) => (
    <path d={p.d} fill-rule={p.evenodd ? 'evenodd' : undefined} clip-rule={p.evenodd ? 'evenodd' : undefined} />
  ))}
</svg>
