---
/**
 * 3D use case scene (three.js, scripts/hero-device.ts), same clay look as the 3D lockers. Fills its parent box.
 * kind: the use case slug (lost-device, faulty-device-swap, temporary-device, eou-rollout, onboarding, offboarding,
 * multi-site); each has its own scene, see hero-device.ts.
 */
interface Props {
  label: string;
  kind?: string;
  surface?: 'light' | 'dark';
  /** dropped: lying screen up on the floor, as if it fell. float: upright, floating above the pings. */
  pose?: 'dropped' | 'float';
}
const { label, kind = 'lost-device', surface = 'dark', pose = 'dropped' } = Astro.props;
---
<div class="device3d" data-device-3d={kind} data-surface={surface} data-label={label} data-pose={pose}></div>

<style>
  .device3d {
    position: relative;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  /* The canvas bleeds past the box (60% left/right, 45% top/bottom, see BLEED in hero-device.ts) and sits behind the
     hero text (z-index -1 inside the hero's isolated stacking context), so rings and glows have no box edge: only the
     hero section's own edge clips them. It never takes the pointer, so the copy and buttons stay clickable. */
  .device3d :global(canvas) {
    position: absolute;
    left: -60%;
    top: -45%;
    width: 220%;
    height: 190%;
    z-index: -1;
    pointer-events: none;
    display: block;
    opacity: 0;
    transition: opacity 700ms var(--ease);
  }
  .device3d:global(.is-3d) :global(canvas) { opacity: 1; }
</style>
