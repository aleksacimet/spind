---
import Logo from './Logo.astro';
import { getContent } from '../content/site';

interface Props {
  /** Home page: header starts transparent over the accent band. */
  overlay?: boolean;
  /** Prefix for anchor links, "" on the home page, "/" elsewhere. */
  base?: string;
  locale?: string;
}
const { overlay = false, base = '', locale = 'en' } = Astro.props;
const t = getContent(locale);
const home = locale === 'en' ? '/' : `/${locale}/`;
import { href as resolve } from '../content/links';
import { iconFor } from '../content/icons';
const prefix = locale === 'en' ? '' : `/${locale}`;
const to = (h: string) => resolve(h, base, prefix);
const groups = t.nav.groups;
// Menus keep 2 link columns + the feature card. A menu with more sections (Case studies, one per industry) stacks them in pairs.
const stacks = (cols: typeof groups[number]['columns']) => cols.length <= 2 ? cols.map((c) => [c]) : [cols.filter((_, i) => i % 2 === 0), cols.filter((_, i) => i % 2 === 1)];
const current = t.nav.languages.find((l) => l.code === locale) ?? t.nav.languages[0];
// Flags drawn inline (no image requests): Germany and the United Kingdom.
const flags: Record<string, string> = {
  de: '<rect width="20" height="4.67" fill="#000"/><rect y="4.67" width="20" height="4.67" fill="#DD0000"/><rect y="9.33" width="20" height="4.67" fill="#FFCE00"/>',
  en: '<rect width="20" height="14" fill="#012169"/><path d="M0 0l20 14M20 0L0 14" stroke="#fff" stroke-width="2.8"/><path d="M0 0l20 14M20 0L0 14" stroke="#C8102E" stroke-width="1.2"/><path d="M10 0v14M0 7h20" stroke="#fff" stroke-width="4.2"/><path d="M10 0v14M0 7h20" stroke="#C8102E" stroke-width="2.4"/>',
};
---
<header class:list={['site-header', { 'is-overlay': overlay }]} data-header>
  <div class="nav-overlay" aria-hidden="true"></div>
  <div class="container header-inner">
    <a class="brand" href={home} aria-label="Spind, home">
      <Logo height={40} title="" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul role="list" class="nav-list">
        {groups.map((g) => (
          <li class="nav-item" data-dd>
            <button class="nav-link nav-trigger" type="button" aria-expanded="false" aria-controls={`dd-${g.id}`} data-dd-trigger>
              {g.label}<span class="chev" aria-hidden="true"></span>
            </button>
            <div class="dd" id={`dd-${g.id}`} data-dd-panel hidden>
              <div class="container dd-inner">
                {stacks(g.columns).map((stack) => (
                  <div class="dd-col">
                    {stack.map((c) => (<>
                    <p class="dd-title"><span class="sq" aria-hidden="true"></span>{c.title}</p>
                    <ul role="list" class="dd-list">
                      {c.items.map((it) => (
                        <li>
                          <a class="dd-link" href={to(it.href)} data-nav-item>
                            <span class="dd-icon" aria-hidden="true"><svg viewBox="0 0 22 22" width="22" height="22"><path d={iconFor(it)} pathLength="1" /></svg></span>
                            <span class="title-body">
                              <span class="dd-label">{it.label}</span>
                              <span class="dd-text">{it.text}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    </>))}
                  </div>
                ))}
                <div class="dd-col dd-col--feature">
                  <p class="dd-title"><span class="sq" aria-hidden="true"></span>{g.feature.label}</p>
                  <div class="dd-feature">
                  <div class="title-body">
                    <p class="dd-feature-title">{g.feature.title}</p>
                    <p class="dd-feature-text">{g.feature.text}</p>
                  </div>
                  <a class="btn btn--cta btn--sm" href={to(g.feature.href)} data-nav-item>{g.feature.cta}<span class="arrow" aria-hidden="true">→</span></a>
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))}
        {t.nav.links.map((l) => (
          <li class="nav-item"><a class="nav-link" href={to(l.href)} data-nav={l.id}>{l.label}</a></li>
        ))}
        <li class="nav-item lang-item">
          <details class="lang" data-lang>
            <summary class="nav-link lang-trigger" aria-label={`${t.nav.languageLabel}: ${current.label}`}>
              <svg class="flag" viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" set:html={flags[current.code]} />
              <span>{current.code.toUpperCase()}</span><span class="chev" aria-hidden="true"></span>
            </summary>
            <ul role="list" class="lang-menu">
              {t.nav.languages.map((l) => (
                <li>
                  {l.available
                    ? <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.code === current.code ? 'true' : undefined}><svg class="flag" viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" set:html={flags[l.code]} />{l.label}</a>
                    : <span class="lang-soon" lang={l.code}><svg class="flag" viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" set:html={flags[l.code]} />{l.label}<em>{t.nav.soon}</em></span>}
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <a class="btn btn--cta btn--sm header-cta" href={to('/contact')}>{t.nav.cta}<span class="arrow" aria-hidden="true">→</span></a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only" data-menu-label data-open={t.nav.menu} data-close={t.nav.close}>{t.nav.menu}</span>
      <span class="bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container" aria-label="Mobile">
      <ul role="list" class="mobile-list">
        {groups.map((g, i) => (
          <li style={`--k:${i}`}>
            <details class="m-group">
              <summary>{g.label}<span class="chev" aria-hidden="true"></span></summary>
              <ul role="list" class="m-sub">
                {g.columns.flatMap((c) => c.items).map((it) => (
                  <li><a href={to(it.href)} data-menu-link>{it.label}<span>{it.text}</span></a></li>
                ))}
              </ul>
            </details>
          </li>
        ))}
        {t.nav.links.map((l, i) => (
          <li style={`--k:${groups.length + i}`}><a class="m-top" href={to(l.href)} data-nav={l.id} data-menu-link>{l.label}</a></li>
        ))}
        <li class="m-lang" style={`--k:${groups.length + t.nav.links.length}`}>
          {t.nav.languages.map((l) => l.available
            ? <a href={l.href} hreflang={l.code} aria-current={l.code === current.code ? 'true' : undefined}><svg class="flag" viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" set:html={flags[l.code]} />{l.label}</a>
            : <span class="lang-soon"><svg class="flag" viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" set:html={flags[l.code]} />{l.label}<em>{t.nav.soon}</em></span>)}
        </li>
      </ul>
      <a class="btn btn--cta" href={to("/contact")} data-menu-link>{t.nav.cta}<span class="arrow" aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>

<script>
  // Language menu: close on outside click and on Escape.
  const lang = document.querySelector<HTMLDetailsElement>('[data-lang]');
  if (lang) {
    document.addEventListener('click', (e) => { if (lang.open && !lang.contains(e.target as Node)) lang.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lang.open) { lang.open = false; lang.querySelector('summary')?.focus(); } });
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--text-neutral-headings);
    background: var(--surface-neutral-page); /* opaque, so the page rails under it never show next to the header's own rail lines */
    border-bottom: var(--hair) solid var(--line);
    backdrop-filter: saturate(1.2) blur(8px); /* bottom line: full screen width, grid line colour */
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
    transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  /* Over the hero band: transparent and white until the page scrolls. */
  .site-header.is-overlay:not(.is-scrolled) {
    background: transparent;
    border-bottom-color: transparent;
    color: var(--text-neutral-onsurface);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header-inner { height: 100%; display: flex; align-items: center; gap: 8px; /* 8px between the language box and Book a call */ padding-inline: var(--inset); box-shadow: inset var(--hair) 0 0 var(--line), inset calc(var(--hair) * -1) 0 0 var(--line); }
  /* Transparent over the hero: the page rails already show through, so the header draws no rail lines of its own (no double line). */
  .is-overlay:not(.is-scrolled):not(.dd-open) .header-inner { box-shadow: none; }
  .brand { display: inline-flex; color: inherit; flex: none; }
  .brand :global(.logo) { height: calc(var(--u) * 1.5); width: auto; }

  .nav { margin-left: auto; align-self: stretch; }
  .nav-list { display: flex; gap: var(--spacing-gap-text-sm); height: 100%; }
  @media (min-width: 1280px) { .nav-list { gap: var(--spacing-gap-general-object-md); } }
  /* Links fill the header height so the indicator sits on the header's bottom line, not under the text. */
  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    line-height: 16px;
    text-decoration: none;
    color: inherit;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: calc(var(--hair) * -1);
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease);
  }
  .site-header.is-scrolled .nav-link::after, .site-header:not(.is-overlay) .nav-link::after { background: var(--surface-action-default); }
  /* No underline on hover or open; only the current section keeps the indicator. Hover is a colour change. */
  .nav-link.is-active::after { transform: scaleX(1); }
  .nav-link:hover { color: var(--text-action-default); }
  .is-overlay:not(.is-scrolled) .nav-link:hover { color: var(--text-action-ondark); }
  .nav-trigger { gap: var(--spacing-gap-text-md); border: 0; background: none; cursor: pointer; padding: 0 16px; transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease); }
  /* Open menu item: boxed between two hairlines, like a pulled-out drawer front. */
  /* Open menu item: light fill only. No side lines, since they can't line up with the menu columns below. */
  .nav-trigger[aria-expanded='true'] { color: var(--text-action-default); } /* text colour only: a fill box would add edges that don't sit on the grid lines */
  .chev { width: 6px; height: 6px; border-right: var(--hair) solid currentColor; border-bottom: var(--hair) solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform var(--dur-fast) var(--ease); }
  [aria-expanded='true'] > .chev, .m-group[open] .chev { transform: translateY(1px) rotate(-135deg); }

  /*
   * Mega menu (Figma component "Mega menu"): two link columns on columns 1-8, each with a label,
   * a hairline and Menu items (icon tile, title, description); a grey panel from column 9 with a dark feature card.
   */
  /* Mega menu, drawer style: a white panel exactly the container width, three columns split by hairlines,
     each with a mono label strip; items are icon + title + text, hover = light fill. */
  .dd {
    position: absolute;
    left: 0; right: 0; top: 100%;
    color: var(--text-neutral-headings);
  }
  .dd[hidden] { display: none; }
  /* Dark overlay over the page while a menu is open; a click on it closes the menu. */
  .nav-overlay {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: -1;
    background: var(--surface-overlay);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease);
  }
  .site-header.dd-open .nav-overlay { opacity: 1; pointer-events: auto; }
  /* While a menu (or the mobile menu) is open, the header is one white surface. */
  .site-header.dd-open, :global(html.menu-open) .site-header.site-header {
    background: var(--surface-neutral-default);
    color: var(--text-neutral-headings);
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .dd-inner {
    display: grid; grid-template-columns: 1fr;
    background: var(--surface-neutral-default);
    box-shadow: inset var(--hair) 0 0 var(--line), inset calc(var(--hair) * -1) 0 0 var(--line), 0 24px 48px -24px rgba(22, 25, 30, 0.18);
    border-top: var(--hair) solid var(--line);
    border-bottom: var(--hair) solid var(--line);
  }
  @media (min-width: 960px) { .dd-inner { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .dd-list + .dd-title { border-top: var(--hair) solid var(--line); } /* second section in a stacked column */
  .dd-col { display: flex; flex-direction: column; }
  .dd-col + .dd-col { border-left: var(--hair) solid var(--line); }
  .dd-title {
    display: flex; align-items: center; gap: 12px; height: 48px; padding: 0 var(--inset); line-height: 16px;
    border-bottom: var(--hair) solid var(--line);
    font-family: var(--font-mono); font-weight: 600; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-neutral-headings);
  }
  .dd-title .sq { width: 6px; height: 6px; background: var(--surface-action-default); flex: none; }
  .dd-list { display: grid; padding: 8px; gap: 4px; } /* 8 + 16 = icons on the 24px line of the label square */
  .dd-link {
    display: flex; align-items: flex-start; gap: var(--spacing-gap-general-object-lg);
    padding: var(--spacing-padding-container-md) calc(var(--inset) - 8px); /* 8px list + this = icons on the inset line */
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease);
  }
  /* Same icon tile as the use case cards: 48px washed square, blue line icon; on hover the square turns blue and the icon redraws in white. */
  .dd-icon { display: grid; place-items: center; flex: none; width: 48px; height: 48px; background: var(--surface-action-washed); transition: background-color var(--dur-fast) var(--ease); }
  .dd-icon svg :is(path, circle, line, rect) { vector-effect: non-scaling-stroke; }
  .dd-icon svg { width: 24px; height: 24px; fill: none; stroke: var(--icon-action-default); stroke-width: var(--icon-stroke); stroke-linecap: round; stroke-linejoin: round; transition: stroke var(--dur-fast) var(--ease); }
  .dd-link:hover, .dd-link:focus-visible { background: var(--surface-action-washed); }
  .dd-link:hover .dd-icon, .dd-link:focus-visible .dd-icon { background: var(--surface-action-default); }
  .dd-link:hover .dd-icon svg, .dd-link:focus-visible .dd-icon svg { stroke: var(--icon-neutral-onsurface); }
  @media (prefers-reduced-motion: no-preference) {
    .dd-link:hover .dd-icon path { animation: icon-draw 300ms var(--ease-out); }
  }
  .dd-link:hover .dd-label { color: var(--text-action-default); }
  .dd-label { font-family: var(--font-display); font-weight: 600; font-size: 18px; line-height: 24px; color: var(--text-neutral-headings); transition: color var(--dur-fast) var(--ease); }
  /* Menu items show only the name; the subtitle opens under it on hover or focus. Title sits centred on the 48px icon at rest. */
  .dd-link .title-body { display: grid; grid-template-rows: auto 0fr; gap: 0; padding-top: 12px; transition: grid-template-rows var(--dur-fast) var(--ease); }
  .dd-text { min-height: 0; overflow: hidden; opacity: 0; font-size: 16px; line-height: 24px; color: var(--text-neutral-body); transition: opacity var(--dur-fast) var(--ease); }
  .dd-link:is(:hover, :focus-visible) .title-body { grid-template-rows: auto 1fr; }
  .dd-link:is(:hover, :focus-visible) .dd-text { opacity: 1; }
  @media (hover: none) { .dd-link .title-body { grid-template-rows: auto 1fr; } .dd-text { opacity: 1; } }
  .dd-feature {
    flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start;
    gap: var(--spacing-gap-text-lg);
    margin: var(--spacing-padding-container-lg) var(--inset) var(--inset);
    padding: var(--spacing-padding-container-2xl);
    min-height: 220px;
    color: var(--text-neutral-onsurface);
    background: var(--ice-1100);
  }
  .dd-feature-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: var(--lh-h3); color: var(--text-neutral-onsurface); }
  .dd-feature-text { font-size: 16px; line-height: 24px; color: var(--text-neutral-ondark); }
  .dd-feature .btn { margin-top: var(--spacing-gap-text-md); }
  @media (prefers-reduced-motion: no-preference) {
    .dd:not([hidden]) { animation: dd-in 360ms var(--ease-out) both; }
    .dd:not([hidden]) .dd-col { animation: dd-fade 420ms var(--ease-out) both; }
    .dd:not([hidden]) .dd-col:nth-child(2) { animation-delay: 50ms; }
    .dd:not([hidden]) .dd-col:nth-child(3) { animation-delay: 100ms; }
  }
  /* Opens like a drawer: the panel slides out from under the header line. */
  @keyframes dd-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes dd-fade { from { opacity: 0; } to { opacity: 1; } }
  .site-header:not(.is-overlay) .nav-link.is-active,
  .site-header.is-scrolled .nav-link.is-active { color: var(--text-action-default); }

  /* Language selector (Figma component "Language selector"): flag, code, chevron. */
  .lang { position: relative; height: 100%; display: flex; align-items: center; }
  /* Language selector: a light filled box (flag, code, chevron); the dropdown opens under it. */
  .lang-trigger { gap: var(--spacing-gap-text-md); list-style: none; cursor: pointer; height: 44px; padding: 0 12px; background: var(--surface-neutral-page); /* same height as the Small button (Book a call) */ transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease); }
  .lang-trigger::after { display: none; }
  .header-cta { height: 44px; padding-block: 0; } /* exactly the language box height */
  .is-overlay:not(.is-scrolled) .lang-trigger { background: color-mix(in srgb, var(--neutral-white) 10%, transparent); }
  .lang-trigger:hover, .lang[open] .lang-trigger { background: var(--surface-action-washed); }
  .is-overlay:not(.is-scrolled) .lang-trigger:hover, .is-overlay:not(.is-scrolled) .lang[open] .lang-trigger { background: color-mix(in srgb, var(--neutral-white) 18%, transparent); }
  .lang-trigger::-webkit-details-marker { display: none; }
  .lang-trigger:hover { color: var(--text-action-default); }
  .is-overlay:not(.is-scrolled) .lang-trigger:hover { color: var(--text-action-ondark); }
  .lang[open] .chev { transform: translateY(1px) rotate(-135deg); }
  .flag { display: block; width: 20px; height: 14px; flex: none; box-shadow: 0 0 0 var(--hair) var(--border-neutral-ondark); }
  .lang-menu {
    position: absolute; right: 0; top: calc(50% + 22px);
    min-width: 200px;
    padding: var(--spacing-padding-container-2xs) 0;
    background: var(--surface-neutral-default);
    color: var(--text-neutral-headings);
    border: var(--hair) solid var(--border-neutral-default);
    box-shadow: 0 24px 48px -24px rgba(22, 25, 30, 0.18);
  }
  .lang-menu a, .lang-soon {
    display: flex; align-items: center; gap: var(--spacing-gap-text-lg);
    padding: var(--spacing-padding-container-xs) var(--spacing-padding-container-sm);
    font-size: 16px; line-height: 24px; text-decoration: none;
  }
  .lang-menu a:hover { background: var(--surface-neutral-page); color: var(--text-action-default); }
  .lang-menu a[aria-current='true'] { font-weight: 500; color: var(--text-action-default); }
  .lang-soon { color: var(--text-disabled); }
  .m-lang { display: flex; flex-wrap: wrap; gap: var(--spacing-gap-general-object-lg); padding: var(--spacing-padding-container-sm) 0; }
  .mobile-list .m-lang a, .m-lang .lang-soon { display: inline-flex; align-items: center; gap: var(--spacing-gap-text-md); padding: 0; font-family: var(--font-body); font-weight: 500; font-size: 16px; line-height: 24px; letter-spacing: 0; }
  .lang-soon em { margin-left: auto; font-style: normal; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .is-overlay:not(.is-scrolled) :focus-visible { outline-color: var(--border-neutral-white); }

  .menu-toggle {
    padding: 0;
    display: none;
    margin-left: auto;
    width: 48px;
    height: 48px;
    border: var(--hair) solid currentColor;
    border-radius: 0;
    background: transparent;
    color: inherit;
    align-items: center;
    justify-content: center;
  }
  .bars { display: grid; gap: 4px; width: 20px; }
  .bars span { display: block; height: 1.5px; background: currentColor; transition: transform var(--dur-fast) var(--ease); }
  .menu-toggle[aria-expanded='true'] .bars span:first-child { transform: translateY(2.75px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .bars span:last-child { transform: translateY(-2.75px) rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 49;
    background: var(--surface-neutral-default);
    color: var(--text-neutral-headings);
    overflow-y: auto;
    padding-block: var(--spacing-padding-container-2xl) var(--spacing-padding-section-xs);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-list { margin-bottom: 32px; }
  .mobile-list a {
    display: block;
    padding: 14px 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .mobile-list a.is-active { color: var(--text-action-default); }
  .m-group summary, .mobile-list .m-top {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 0;
    font-family: var(--font-display); font-weight: 600; font-size: 28px; line-height: 36px; letter-spacing: -0.01em;
    list-style: none; cursor: pointer;
  }
  .m-group summary::-webkit-details-marker { display: none; }
  .m-group .chev { width: 10px; height: 10px; }
  .m-sub { display: grid; padding: 0 0 var(--spacing-padding-container-sm); }
  .mobile-list .m-sub a { display: grid; gap: 0; padding: var(--spacing-padding-container-2xs) 0; border: 0; font-size: 18px; line-height: 24px; letter-spacing: 0; }
