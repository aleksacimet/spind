---
interface Props {
  id?: string;
  title: string;
  intro?: string;
  shade?: boolean;
  /** Centred heading: title above intro, both centred (Problem section in Figma). */
  center?: boolean;
  class?: string;
  /** Drawer label; defaults to sectionLabels[id]. */
  label?: string;
  /** Optional link on the right of the title (e.g. "All customer stories"). */
  link?: { label: string; href: string };
}
import DrawerHead from './DrawerHead.astro';
import { getContent } from '../content/site';
const { id, title, intro, shade = false, center = false, class: className = '', label, link } = Astro.props;
const drawerLabel = label ?? (id ? getContent('en').sectionLabels[id] : undefined);
const headingId = `${id ?? title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-title`;
---
<section
  id={id}
  class:list={['section', { 'section--shade': shade }, className]}
  aria-labelledby={headingId}
  data-section={id}
  data-snap
>
  <div class="container">
    {drawerLabel && <DrawerHead label={drawerLabel} />}
    <header class:list={['section-head', { 'section-head--center': center }]} data-snap data-reveal>
      <h2 id={headingId} data-split>{title}</h2>
      {center && intro && <p class="intro">{intro}</p>} {/* No subtitle next to a title: the title carries the section. */}
      {link && <a class="btn btn--secondary btn--sm section-link" href={link.href}>{link.label}<span class="arrow" aria-hidden="true">→</span></a>}
    </header>
    <slot />
  </div>
</section>
