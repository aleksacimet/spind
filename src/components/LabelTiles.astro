---
/**
 * Labelled tiles: a row of tiles, each with a small label (Stage 1, Level 2 ...), an optional icon, title, text,
 * optional small chips, a note and a status pill. The first tile can be the blue accent.
 * Used on the Integrations page for "Partner access" (levels) and on the Locker page for "What your site needs".
 * span: desktop columns per tile (4 = three in a row, 3 = four in a row).
 */
import StatusPill from './StatusPill.astro';
import { integrationIcons } from '../content/icons';
import type { IntegrationStatus } from '../content/site';
interface Item { label: string; title: string; text: string; key?: string; note?: string; chips?: string[]; status?: IntegrationStatus }
interface Props { items: Item[]; accentFirst?: boolean; span?: number }
const { items, accentFirst = true, span = 4 } = Astro.props;
---
<ol class="tiles lt" role="list" style={`--lt-span:${span}`}>
  {items.map((it, i) => (
    <li class:list={['tile', 'lt-tile', { 'tile--accent': accentFirst && i === 0 }]} data-reveal="drawer" style={`--d:${i * 90}ms`}>
      <div class="lt-top">
        <p class="overline lt-label">{it.label}</p>
        {it.key && <svg class="line-icon lt-icon" viewBox="0 0 22 22" width="24" height="24" aria-hidden="true"><path d={integrationIcons[it.key]} pathLength="1" /></svg>}
      </div>
      <div class="title-body"><h3>{it.title}</h3><p>{it.text}</p></div>
      {it.chips && it.chips.length > 0 && <ul class="lt-chips" role="list">{it.chips.map((c) => <li>{c}</li>)}</ul>}
      {(it.note || it.status) && (
        <div class="lt-foot">
          {it.note && <p class="lt-note">{it.note}</p>}
          {it.status && <StatusPill status={it.status} />}
        </div>
      )}
    </li>
  ))}
</ol>

<style>
  .lt { grid-auto-rows: auto; }
  .lt-tile { grid-column: 1 / -1; grid-row: auto; min-height: 0; display: flex; flex-direction: column; gap: var(--spacing-gap-general-object-lg); }
  .lt-tile h3 { margin: 0; }
  .lt-top { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-gap-general-object-md); }
  .lt-label { color: var(--text-action-default) !important; }
  .lt-icon { stroke: var(--icon-action-strong); flex: none; }
  .tile--accent .lt-label { color: var(--text-neutral-onsurface) !important; }
  .tile--accent .lt-icon { stroke: var(--icon-neutral-onsurface); }
  .lt-chips { display: flex; flex-wrap: wrap; gap: var(--spacing-gap-text-md); }
  .lt-chips li { display: inline-flex; align-items: center; height: 28px; padding: 0 12px; font-family: var(--font-mono); font-weight: 600; font-size: 12px; line-height: 16px; letter-spacing: 0.06em; color: var(--text-neutral-headings); box-shadow: inset 0 0 0 var(--hair) var(--border-neutral-strong); }
  .lt-foot { margin-top: auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--spacing-gap-text-lg); padding-top: var(--spacing-padding-container-sm); box-shadow: inset 0 var(--hair) 0 var(--border-neutral-default); }
  .lt-note { font-family: var(--font-display); font-weight: 600; color: var(--text-neutral-headings) !important; }
  .tile--accent .lt-note { color: var(--text-neutral-onsurface) !important; }
  .tile--accent .lt-foot { box-shadow: inset 0 var(--hair) 0 color-mix(in srgb, var(--neutral-white) 30%, transparent); }
  @media (min-width: 640px) { .lt-tile { grid-column: span 4; } }
  @media (min-width: 960px) { .lt-tile { grid-column: span var(--lt-span, 4); min-height: 240px; } }
</style>
