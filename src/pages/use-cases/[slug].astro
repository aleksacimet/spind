---
/**
 * Use case page. Every use case tells the same story in the same order, each section is one shared component:
 * hero (the promise) → at a glance (does it fit me) → the problem (a typical day today, who pays for it) →
 * how it works (four steps, who does what) → activity log (what IT sees) → what changes (for IT, for employees) →
 * what it connects to (systems and service partners) → customer story → questions → next step → more use cases.
 * Structure follows what competitors do well (Cora: situation, how it works, advantages per side; NetLocker: starting
 * situation and an audit-proof record of every handover).
 */
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import TemplateHero from '../../components/TemplateHero.astro';
import UseCaseCard from '../../components/UseCaseCard.astro';
import UcFacts from '../../components/usecase/UcFacts.astro';
import UcSituation from '../../components/usecase/UcSituation.astro';
import UcSteps from '../../components/usecase/UcSteps.astro';
import UcLog from '../../components/usecase/UcLog.astro';
import UcBenefits from '../../components/usecase/UcBenefits.astro';
import UcConnects from '../../components/usecase/UcConnects.astro';
import UcProof from '../../components/usecase/UcProof.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { getContent } from '../../content/site';

export function getStaticPaths() {
  return getContent('en').solutions.items.map((s) => ({ params: { slug: s.slug } }));
}

const locale = Astro.currentLocale ?? 'en';
const t = getContent(locale ?? Astro.currentLocale);
const S = t.solutions;
const s = S.items.find((i) => i.slug === Astro.params.slug)!;
const others = S.items.filter((i) => i.slug !== s.slug);
const facts = (['who', 'devices', 'start', 'where'] as const).map((k) => ({ label: S.facts[k], value: s.facts[k] }));
---
<Base title={`${s.title} | Spind`} description={s.intro} locale={locale} darkHero>
  <TemplateHero id="sol" label={`${S.label} · ${s.title}`} title={s.heroTitle} intro={s.intro} primary={S.primary} secondary={S.secondary} visualLabel={`${s.title} ${S.visualLabel}`} device={s.slug === 'lost-device' ? 'lost-phone' : undefined} />

  <UcFacts items={facts} />
  <UcSituation title={s.situation.title} scene={s.situation.scene} pains={s.situation.pains} />
  <UcSteps title={S.flowTitle} steps={s.steps} />
  <UcLog title={s.log.title} text={s.log.text} locker={s.log.locker} entries={s.log.entries} />
  <UcBenefits title={S.benefitsTitle} it={s.benefits.it} people={s.benefits.people} />
  <UcConnects items={s.connects} />
  <UcProof slug={s.slug} />
  <Faq locale={locale} id="uc-faq" title={S.faqTitle} items={s.faq} />
  <CtaBand id="uc-cta" title={s.cta.title} text={s.cta.text} cta={S.primary} />

  <Section id="more" title={S.moreTitle}>
    <ul class="tiles more" role="list">
      {others.map((o, i) => (
        <UseCaseCard slug={o.slug} title={o.title} text={o.heroTitle} delay={i * 60} />
      ))}
    </ul>
  </Section>
</Base>

<style>
  .tiles { grid-auto-rows: auto; }
  .more :global(.uc) { grid-row: auto; min-height: 160px; }
</style>
