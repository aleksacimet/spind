---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import LockerDrawing from '../../components/LockerDrawing.astro';
import UseCaseCard from '../../components/UseCaseCard.astro';
import { getContent } from '../../content/site';

export function getStaticPaths() {
  return getContent('en').solutions.items.map((s) => ({ params: { slug: s.slug } }));
}

const locale = 'en';
const t = getContent(locale);
const S = t.solutions;
const s = S.items.find((i) => i.slug === Astro.params.slug)!;
const others = S.items.filter((i) => i.slug !== s.slug);
---
<Base title={`${s.title} | Spind`} description={s.intro} locale={locale} darkHero>
  <section class="sol-hero space" aria-labelledby="sol-title" data-hero>
    <div class="space-glow" aria-hidden="true"></div>
    <div class="container sol-hero-grid">
      <div class="sol-copy">
        <h1 id="sol-title">{s.heroTitle}</h1>
        <p class="sol-intro">{s.intro}</p>
        <div class="sol-actions">
          <a class="btn btn--cta" href="/contact">{S.primary}<span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--secondary" href="/business-case">{S.secondary}</a>
        </div>
      </div>
      <div class="sol-visual">
        <LockerDrawing id={`sol-${s.slug}`} modules={['master', 's24']} gap={17.5} animate accent={null} label={`${s.title} with a Spind locker`} />
      </div>
    </div>
  </section>

  <Section id="flow" title={S.flowTitle}>
    <ol class="tiles flow" role="list">
      {s.steps.map((st, i) => (
        <li class:list={['tile', { 'tile--accent': i === 2 }]} data-reveal="drawer" style={`--d:${i * 90}ms`}>
          <span class="step-num tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="title-body">
            <h3>{st.title}</h3>
            <p>{st.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="more" title={S.moreTitle}>
    <ul class="tiles more" role="list">
      {others.map((o, i) => (
        <UseCaseCard slug={o.slug} title={o.title} text={o.heroTitle} delay={i * 60} />
      ))}
    </ul>
  </Section>

</Base>

<style>
  .sol-hero { padding-top: var(--hero-top); padding-bottom: var(--hero-bottom); }
  .sol-hero-grid { display: flex; flex-direction: column; gap: var(--spacing-gap-general-section-md); }
  .sol-copy { display: flex; flex-direction: column; gap: var(--spacing-gap-general-object-lg); }
  .sol-hero h1 { font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: -0.02em; max-width: 640px; }
  .sol-intro { max-width: 520px; }
  .sol-actions { display: flex; flex-wrap: wrap; gap: var(--spacing-gap-general-object-md); margin-top: var(--spacing-gap-text-md); }
  .sol-visual { width: 100%; max-width: 384px; }

  .tiles { grid-auto-rows: auto; }
  .tiles .tile { grid-column: 1 / -1; grid-row: auto; min-height: 0; display: flex; flex-direction: column; gap: var(--spacing-gap-text-md); }
  .tiles .tile h3 { margin: 0; }
  .step-num { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: var(--lh-h3); color: var(--text-neutral-subtle); margin-bottom: var(--spacing-gap-general-object-md); }
  .flow .tile--accent .step-num { color: var(--text-neutral-onsurface); }

  .more :global(.uc) { grid-row: auto; min-height: 160px; }

  @media (min-width: 640px) {
    .tiles .tile { grid-column: span 4; }
  }
  @media (min-width: 960px) {
    .sol-hero-grid { flex-direction: row; align-items: center; justify-content: space-between; }
    .sol-copy { width: 600px; }
    .sol-visual { width: 384px; }
    .flow .tile { grid-column: span 3; min-height: 260px; }
  }
  @media (min-width: 1280px) {
    .sol-hero h1 { font-size: var(--fs-page); line-height: var(--lh-page); letter-spacing: -0.03em; }
  }
</style>
