---
/**
 * Workflows: the mechanics behind every use case. How a handover runs (the four steps with every option), the five
 * actions and which use case uses which, today compared with Spind, questions, next step, more of the product.
 * How it works, Go live and the general FAQ stay on the home page, so nothing here repeats it.
 */
import Base from '../layouts/Base.astro';
import TemplateHero from '../components/TemplateHero.astro';
import HandoverSteps from '../components/sections/HandoverSteps.astro';
import ActionMatrix from '../components/sections/ActionMatrix.astro';
import Compare from '../components/sections/Compare.astro';
import Faq from '../components/sections/Faq.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import ProductMore from '../components/sections/ProductMore.astro';
import { getContent } from '../content/site';
const locale = Astro.currentLocale ?? 'en';
const t = getContent(locale ?? Astro.currentLocale);
const W = t.workflowsPage;
---
<Base title={`${W.label} | Spind`} description={W.meta} locale={locale} darkHero>
  <TemplateHero id="workflows-page" label={W.label} title={W.title} intro={W.intro} primary={W.primary} secondary={W.secondary} />
  <HandoverSteps />
  <ActionMatrix />
  <Compare />
  <Faq locale={locale} id="workflow-faq" title={W.faqTitle} items={W.faq} />
  <CtaBand id="wf-cta" title={W.ctaTitle} text={W.ctaText} cta={W.cta} />
  <ProductMore current="workflows" />
</Base>
