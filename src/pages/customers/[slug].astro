---
import DrawerHead from '../../components/DrawerHead.astro';
import Base from '../../layouts/Base.astro';
import MockLogo from '../../components/MockLogo.astro';
import Quotes from '../../components/sections/Quotes.astro';
import { getContent, showStories } from '../../content/site';
import { solutionIcons } from '../../content/icons';

export function getStaticPaths() {
  return showStories ? getContent('en').proof.stories.map((s) => ({ params: { slug: s.slug } })) : [];
}
const t = getContent('en');
const c = t.customers;
const s = t.proof.stories.find((x) => x.slug === Astro.params.slug)!;
const logoName = t.proof.logos.find((l) => l.key === s.logo)?.name ?? s.company;
// Profile circle: photo when one is set in site.ts, otherwise initials (same as the quote cards).
const initials = (name: string) => name.replace(/^Dr\.\s*/, '').split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
const sol = (slug: string) => t.solutions.items.find((i) => i.slug === slug)!;
---
<Base title={`${s.company} | ${c.title} | Spind`} description={s.summary} darkHero>
  <article>
    <!-- One dark surface for the hero and the top half of the metric cards, so the mouse glow runs across both
         without a seam. The dark part (and the glow) stops in the middle of the first row of cards. -->
    <div class="space page-hero st-top" data-hero style={`--n:${s.metrics.length}`}>
      <div class="st-glow" aria-hidden="true"><div class="space-glow"></div></div>
      <header class="container st-hero">
        <div class="st-copy">
          <h1>{s.headline}</h1>
          <p class="intro">{s.summary}</p>
        </div>
        <div class="st-brand"><MockLogo key={s.logo} name={logoName} /></div>
      </header>
      <section class="container st-metrics" aria-label={c.sections.results}>
        <dl>
          {s.metrics.map((m, i) => (
            <div data-reveal="drawer" style={`--d:${i * 90}ms`}><dt>{m.label}</dt><dd class="tabular">{m.value}</dd></div>
          ))}
        </dl>
      </section>
    </div>

    <section class="section st-section"><div class="container"><DrawerHead label={s.company} /><div class="st-body">
      <aside class="facts" aria-label={s.company}>
        <dl>
          <div><dt class="label">{c.facts.industry}</dt><dd>{s.industry}</dd></div>
          <div><dt class="label">{c.facts.sites}</dt><dd>{s.sites}<span class="cities">{s.cities.join(', ')}</span></dd></div>
          <div><dt class="label">{c.facts.lockers}</dt><dd>{s.lockers}</dd></div>
          <div>
            <dt class="label">{c.facts.solutions}</dt>
            <dd><ul role="list" class="sol-links">
              {s.solutions.map((k) => (
                <li><a href={`/use-cases/${k}`}><svg viewBox="0 0 22 22" width="20" height="20" aria-hidden="true"><path d={solutionIcons[k]} /></svg>{sol(k).title}</a></li>
              ))}
            </ul></dd>
          </div>
        </dl>
      </aside>
      <div class="text">
        <section data-reveal><h2>{c.sections.challenge}</h2><p>{s.challenge}</p></section>
        <section data-reveal><h2>{c.sections.solution}</h2><p>{s.solution}</p></section>
        <figure class="big-quote" data-reveal="drawer">
          <blockquote><p>“{s.quote.text}”</p></blockquote>
          <figcaption>
            {s.quote.photo
              ? <img class="q-photo" src={s.quote.photo} alt="" width="48" height="48" loading="lazy" />
              : <span class="q-photo" aria-hidden="true">{initials(s.quote.name)}</span>}
            <span class="q-who"><strong>{s.quote.name}</strong><span>{s.quote.role}</span></span>
          </figcaption>
        </figure>
        <section data-reveal><h2>{c.sections.results}</h2><p>{s.results}</p></section>
      </div>
    </div></div></section>
  </article>

  <Quotes title={c.more} exclude={s.slug} allLink />
</Base>

<style>
  .page-hero :global(.mock-logo) { color: var(--text-neutral-ondark); }
  .st-hero { padding-top: var(--hero-top); padding-bottom: var(--hero-bottom); display: flex; flex-direction: column; gap: var(--spacing-gap-general-object-lg); }
  .st-brand { display: flex; align-items: center; gap: var(--spacing-gap-general-object-md); }
  .st-copy { display: flex; flex-direction: column; gap: var(--spacing-gap-general-object-lg); }
  /* Title and summary on the left, the company logo on the right, both on the inset lines. */
  @media (min-width: 960px) {
    .st-hero { flex-direction: row; align-items: center; justify-content: space-between; gap: var(--spacing-gap-general-section-md); }
    .st-copy { max-width: 800px; }
    .st-brand :global(.mock-logo) { height: 40px; }
  }
  .st-hero h1 { font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: -0.02em; max-width: 840px; } /* Heading/H2 */
  .st-hero .intro { max-width: 600px; color: var(--text-neutral-ondark); }

  /* Dark only down to the middle of the first row of cards (--light is the part below that). Cards have a fixed height. */
  .st-top { --card-h: 132px; --rows: var(--n); --light: calc(var(--card-h) * var(--rows) - var(--card-h) / 2); background: linear-gradient(to bottom, var(--ice-1100) calc(100% - var(--light)), transparent 0); border-bottom: 0 !important; }
  .st-top.space::before, .st-top.space::after { bottom: var(--light); }
  .st-glow { position: absolute; inset: 0 0 var(--light) 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .st-metrics { position: relative; }
  .st-metrics dl > div { height: var(--card-h); padding-block: var(--spacing-padding-container-lg) !important; justify-content: center !important; } /* 24 + 48 + 8 + 28 + 24 */
  @media (min-width: 960px) { .st-top { --card-h: 132px; --rows: 1; } }
  .st-metrics dl { display: grid; clip-path: inset(0 0 0 var(--hair)); box-shadow: var(--hair) var(--hair) 0 0 var(--border-neutral-default); }
  .st-metrics dl > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--spacing-gap-text-md); padding: var(--pad-block) var(--inset); background: var(--surface-neutral-default); border-top: var(--hair) solid var(--border-neutral-default); border-left: var(--hair) solid var(--border-neutral-default); }
  .st-metrics dd { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-stat); line-height: 48px; letter-spacing: -0.03em; color: var(--text-neutral-headings); }
  .st-metrics dt { color: var(--text-neutral-body); }

  .st-body { display: flex; flex-direction: column; gap: var(--spacing-gap-general-section-md); padding-block: var(--spacing-padding-section-md) var(--spacing-padding-section-xl); }
  /* Facts widget: white card on the page background. */
  .facts dl { display: grid; gap: var(--spacing-gap-general-object-lg); padding: var(--pad-block) var(--inset); background: var(--surface-neutral-default); box-shadow: inset 0 0 0 var(--hair) var(--border-neutral-default); }
  .facts dd { margin-top: var(--spacing-gap-text-sm); font-family: var(--font-display); font-weight: 600; color: var(--text-neutral-headings); }
  .cities { display: block; font-family: var(--font-body); font-weight: 400; font-size: 14px; line-height: 20px; color: var(--text-neutral-body); margin-top: var(--spacing-gap-text-sm); }
  .sol-links { display: grid; gap: var(--spacing-gap-text-md); margin-top: var(--spacing-gap-text-sm); }
  .sol-links a { display: inline-flex; align-items: center; gap: var(--spacing-gap-text-md); color: var(--text-action-default); text-decoration: none; }
  .sol-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .sol-links svg { fill: none; stroke: currentColor; stroke-width: var(--stroke); vector-effect: non-scaling-stroke; flex: none; }
  .text { display: grid; gap: var(--spacing-gap-general-section-md); max-width: 720px; }
  .text h2 { font-size: var(--fs-subtitle); line-height: var(--lh-subtitle); letter-spacing: 0; margin-bottom: var(--spacing-gap-text-md); }
  .text p { color: var(--text-neutral-body); }
  .big-quote { margin: 0; padding: var(--pad-block) var(--inset); background: var(--surface-action-default); color: var(--text-neutral-onsurface); display: grid; gap: var(--spacing-gap-general-object-lg); }
  .big-quote blockquote p { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: -0.01em; color: var(--text-neutral-onsurface); }
  .big-quote figcaption { display: flex; align-items: center; gap: var(--spacing-gap-general-object-md); }
  .q-photo { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--scale-max); object-fit: cover; background: var(--surface-action-hover); color: var(--text-neutral-onsurface); font-family: var(--font-display); font-weight: 600; font-size: 16px; line-height: 24px; }
  .q-who { display: grid; }
  .big-quote figcaption span { color: var(--text-neutral-onsurface); }

  @media (min-width: 960px) {
    .st-metrics dl { grid-template-columns: repeat(3, 1fr); }
    .st-body { flex-direction: row; justify-content: space-between; }
    .facts { width: 300px; flex: none; }
    .facts dl { position: sticky; top: calc(var(--header-h) + var(--spacing-gap-general-group-lg)); }
    .text { width: 800px; max-width: none; }
  }
  @media (min-width: 1280px) {
  }
</style>
