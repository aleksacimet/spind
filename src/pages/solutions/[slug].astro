---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import LockerDrawing from '../../components/LockerDrawing.astro';
import Faq from '../../components/sections/Faq.astro';
import Contact from '../../components/sections/Contact.astro';
import { getContent } from '../../content/site';

export function getStaticPaths() {
  return getContent('en').solutions.items.map((s) => ({ params: { slug: s.slug } }));
}

const locale = 'en';
const t = getContent(locale);
const S = t.solutions;
const s = S.items.find((i) => i.slug === Astro.params.slug)!;
const others = S.items.filter((i) => i.slug !== s.slug);
// A different open drawer on every solution page.
const accentIndex = (S.items.indexOf(s) * 5 + 4) % 24;
---
<Base title={`${s.title} | Spind`} description={s.intro} locale={locale}>
  <section class="sol-hero" aria-labelledby="sol-title">
    <div class="container sol-hero-grid">
      <div class="sol-copy">
        <h1 id="sol-title">{s.heroTitle}</h1>
        <p class="sol-intro">{s.intro}</p>
        <div class="sol-actions">
          <a class="btn btn--primary" href="#contact">{S.primary}<span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--secondary" href="/#business-case">{S.secondary}</a>
        </div>
      </div>
      <div class="sol-visual">
        <LockerDrawing id={`sol-${s.slug}`} modules={['master', 's24']} accent={{ module: 's24', index: accentIndex }} label={`${s.title} with a Spind locker, one drawer open`} />
      </div>
    </div>
  </section>

  <Section id="today" title={S.todayTitle}>
    <ul class="tiles today" role="list">
      {s.today.map((item, i) => (
        <li class="tile" data-reveal="drawer" style={`--d:${i * 90}ms`}>
          <svg class="x" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 1.5C6.15 1.5 1.5 6.15 1.5 12S6.15 22.5 12 22.5 22.5 17.85 22.5 12 17.85 1.5 12 1.5Zm4.05 15.75L12 13.2l-4.05 4.05-1.2-1.2L10.8 12 6.75 7.95l1.2-1.2L12 10.8l4.05-4.05 1.2 1.2L13.2 12l4.05 4.05-1.2 1.2Z" fill="var(--danger)" /></svg>
          <p>{item}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="flow" title={S.flowTitle} shade>
    <ol class="tiles flow" role="list">
      {s.steps.map((st, i) => (
        <li class:list={['tile', { 'tile--accent': i === 2 }]} data-reveal="drawer" style={`--d:${i * 90}ms`}>
          <span class="step-num tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{st.title}</h3>
          <p>{st.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="roles" title={t.roles.title}>
    <ul class="tiles roles" role="list">
      {t.roles.items.map((r, i) => (
        <li class="tile" data-reveal="drawer" style={`--d:${i * 90}ms`}>
          <p class="label">{String(i + 1).padStart(2, '0')}</p>
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="benefits" title={S.benefitsTitle}>
    <ul class="tiles benefits" role="list">
      {s.benefits.map((b, i) => (
        <li class:list={['tile', { 'tile--alt': i === 1 }]} data-reveal="drawer" style={`--d:${i * 90}ms`}>
          <span class="tick" aria-hidden="true"></span>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Faq locale={locale} title={S.faqTitle} only={s.faq} id="solution-faq" />

  <Section id="more" title={S.moreTitle}>
    <ul class="tiles more" role="list">
      {others.map((o, i) => (
        <li class="tile tile--hover more-tile" data-reveal="drawer" style={`--d:${i * 60}ms`}>
          <h3><a href={`/solutions/${o.slug}`}>{o.title}</a></h3>
          <p>{o.heroTitle}</p>
          <span class="go" aria-hidden="true">→</span>
        </li>
      ))}
    </ul>
  </Section>

  <Contact locale={locale} />
</Base>

<style>
  .sol-hero { padding-top: calc(var(--header-h) + 48px); padding-bottom: 64px; }
  .sol-hero-grid { display: flex; flex-direction: column; gap: 48px; }
  .sol-copy { display: flex; flex-direction: column; gap: 24px; }
  .sol-hero h1 { font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: -0.02em; max-width: 640px; }
  .sol-intro { max-width: 520px; color: var(--ink-muted-strong); }
  .sol-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 8px; }
  .sol-visual { width: 100%; max-width: 480px; filter: drop-shadow(0 30px 30px rgba(22, 25, 30, 0.1)); }

  .tiles { grid-auto-rows: auto; }
  .tiles .tile { grid-column: 1 / -1; grid-row: auto; min-height: 0; padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .tiles .tile h3 { margin: 0; }
  .x { width: 20px; height: 20px; margin-bottom: 16px; }
  .roles .label { margin-bottom: 16px; }
  .today p { color: var(--ink); font-family: var(--font-display); font-weight: 500; font-size: var(--fs-subtitle); line-height: var(--lh-subtitle); }
  .step-num { font-family: var(--font-display); font-weight: 500; font-size: 28px; line-height: 40px; color: var(--ink-muted); margin-bottom: 16px; }
  .flow .tile--accent .step-num { color: #fff; }
  .tile--alt { background: var(--paper-shade); border-color: transparent; box-shadow: none; }
  .tile--alt p { color: var(--ink); }
  .tick { width: 8px; height: 8px; margin: 8px 0 16px 4px; background: var(--accent); transform: rotate(45deg); }

  .tiles .more-tile { padding-right: 56px; }
  .more-tile a { text-decoration: none; }
  .more-tile a::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .more-tile:hover h3 { color: var(--accent-ink); }
  .go { position: absolute; right: 24px; top: 24px; font-family: var(--font-display); font-size: 20px; line-height: 28px; color: var(--accent-ink); transition: transform var(--dur-fast) var(--ease); }
  .more-tile:hover .go { transform: translateX(4px); }

  @media (min-width: 640px) {
    .tiles .tile { grid-column: span 4; }
  }
  @media (min-width: 960px) {
    .sol-hero-grid { flex-direction: row; align-items: center; justify-content: space-between; }
    .sol-copy { width: 600px; }
    .sol-visual { width: 480px; }
    .today .tile, .benefits .tile { min-height: 200px; }
    .flow .tile { grid-column: span 3; min-height: 260px; }
    .more .tile { min-height: 160px; }
  }
  @media (min-width: 1280px) {
    .sol-hero { padding-top: 148px; padding-bottom: 80px; }
    .sol-hero h1 { font-size: 56px; line-height: 64px; letter-spacing: -0.03em; }
  }
</style>
