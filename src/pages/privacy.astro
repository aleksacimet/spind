---
import Base from '../layouts/Base.astro';
import LegalPage from '../components/LegalPage.astro';
import { getContent } from '../content/site';
import { lp } from '../i18n';
const t = getContent(Astro.currentLocale);
const page = t.legal.privacy;
---
<Base title={`${page.title} | Spind`} description={page.description}>
  <LegalPage title={page.title} backLabel={t.legal.back} backHref={lp(Astro.currentLocale, '/')}>
    {page.body.map((p) => <p>{p}</p>)}
    <h2>{page.heading}</h2>
    <p>{page.todo}</p>
  </LegalPage>
</Base>
