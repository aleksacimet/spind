---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import TemplateHero from '../components/TemplateHero.astro';
import SecurityBand from '../components/sections/SecurityBand.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import LissaLogo from '../components/LissaLogo.astro';
import GoLive from '../components/sections/GoLive.astro';
import Faq from '../components/sections/Faq.astro';
import { getContent } from '../content/site';
import { integrationIcons } from '../content/icons';
import StatusPill from '../components/StatusPill.astro';

const locale = Astro.currentLocale ?? 'en';
const t = getContent(locale ?? Astro.currentLocale);
const P = t.integrationsPage;
const icon = (k: string) => integrationIcons[k];
// The map's left column lists the customer's systems only: LISSA Asset is our application, shown in the middle.
const mapSystems = P.systems.filter((s) => s.key !== 'lissa');
---
<!-- Integrations page for enterprise IT (ideas from Cora's "REST APIs / Plugins / Data security" slide):
     landscape map, systems, connection methods, security, rollout, FAQ, CTA. -->
<Base title={`${P.label} | Spind`} description={P.meta} locale={locale} darkHero>
  <TemplateHero id="ip" label={P.label} title={P.title} intro={P.intro} primary={P.primary} secondary={P.secondary} visual={false} />

  <!-- Landscape map: your systems -> LISSA Asset -> Spind lockers at every site. Dots flow along the lines. -->
  <Section id="map" title={P.mapTitle} intro={P.mapIntro}>
    <div class="map" data-reveal>
      <div class="map-col">
        <p class="label map-h">{P.mapLeft}</p>
        <ul role="list" class="chips">
          {mapSystems.map((s, i) => (
            <li class="chip" style={`--k:${i}`}><svg class="line-icon" viewBox="0 0 22 22" width="20" height="20" aria-hidden="true"><path d={icon(s.key)} /></svg>{s.title}</li>
          ))}
        </ul>
      </div>
      <div class="map-link" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="map-hub glow-band on-accent" data-hero>
        <div class="space-glow" aria-hidden="true"></div>
        <svg class="hub-s" viewBox="0 0 1238 1371" width="48" height="53" aria-hidden="true"><rect width="1238" height="1371" fill="#FFD369"/><path d="M622.861 953.144C583.923 953.144 550.754 945.693 523.353 930.791C495.952 915.889 474.56 894.737 459.177 867.336C444.275 839.935 435.381 807.006 432.497 768.549L535.611 763.501C538.495 785.133 544.024 803.401 552.196 818.303C560.368 833.205 570.703 844.262 583.202 851.473C595.701 858.683 610.603 862.289 627.909 862.289C643.292 862.289 656.271 860.125 666.847 855.799C677.904 851.473 686.316 845.223 692.085 837.051C697.853 828.398 700.738 818.063 700.738 806.045C700.738 793.065 697.613 781.528 691.364 771.433C685.114 761.338 674.058 752.204 658.194 744.032C642.811 735.86 620.938 728.168 592.576 720.958C558.445 712.305 530.083 701.969 507.489 689.951C485.376 677.933 469.032 662.55 458.456 643.802C447.88 625.054 442.592 601.499 442.592 573.137C442.592 541.89 449.322 514.73 462.782 491.655C476.723 468.1 496.673 450.073 522.632 437.574C549.071 424.595 581.039 418.105 618.535 418.105C655.069 418.105 686.316 424.836 712.275 438.296C738.234 451.756 758.424 471.225 772.845 496.703C787.748 522.181 796.4 553.187 798.804 589.722L694.969 594.769C692.565 576.983 687.999 561.6 681.269 548.62C674.538 535.641 665.405 525.786 653.868 519.056C642.811 512.326 629.591 508.961 614.208 508.961C593.538 508.961 576.953 514.249 564.454 524.825C552.436 535.401 546.427 549.822 546.427 568.089C546.427 580.107 549.311 590.443 555.08 599.096C561.329 607.749 571.905 615.44 586.807 622.17C602.19 628.9 623.102 635.871 649.541 643.081C688.479 652.215 719.245 664.233 741.839 679.135C764.433 694.037 780.537 711.584 790.151 731.774C799.765 751.964 804.573 775.519 804.573 802.439C804.573 833.205 797.362 859.885 782.94 882.479C768.519 904.592 747.608 921.898 720.207 934.396C693.286 946.895 660.838 953.144 622.861 953.144Z" fill="#222831"/><path d="M291 595H194V1177H1044V953H947V1080H291V595ZM291 291V418H194V194H1044V763H947V291H291Z" fill-rule="evenodd" fill="#222831"/></svg>
        <p class="hub-title">{P.mapHub}</p>
        <p class="hub-text">{P.mapHubText}</p>
      </div>
      <div class="map-link" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="map-col">
        <p class="label map-h">{P.mapRight}</p>
        <ul role="list" class="sites">
          {P.sites.map((s) => (
            <li class="site">
              <svg viewBox="0 0 44 32" width="44" height="32" aria-hidden="true"><rect x="1" y="1" width="20" height="30" rx="1" class="lk" /><rect x="23" y="1" width="20" height="30" rx="1" class="lk" /><rect x="5" y="5" width="12" height="8" rx="1.5" class="lk-scr" />{[0,1,2,3,4].map((r) => <line x1="25" x2="41" y1={6 + r * 5} y2={6 + r * 5} class="lk-ln" />)}</svg>
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="systems" title={P.systemsTitle} intro={P.systemsIntro}>
    <ul class="tiles sys" role="list">
      {P.systems.map((s, i) => (
        <li class="tile tile--hover sys-item" data-reveal="drawer" data-spot style={`--d:${(i % 3) * 90}ms`}>
          {'logo' in s && s.logo
            ? <LissaLogo />
            : <span class="ic-box" aria-hidden="true"><svg class="line-icon" viewBox="0 0 22 22" width="24" height="24"><path d={icon(s.key)} pathLength="1" /></svg></span>}
          <div class="title-body">
            <h3>{s.title}</h3>
            <p class="ex">{s.examples}</p>
            <p>{s.text}</p>
            <StatusPill status={s.status} class="tile-pill" />
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="methods" title={P.methodsTitle} intro={P.methodsIntro}>
    <ul class="tiles four" role="list">
      {P.methods.map((m, i) => (
        <li class="tile tile--hover" data-reveal="drawer" data-spot style={`--d:${i * 80}ms`}>
          <span class="ic-box" aria-hidden="true"><svg class="line-icon" viewBox="0 0 22 22" width="24" height="24"><path d={icon(m.key)} pathLength="1" /></svg></span>
          <div class="title-body"><h3>{m.title}</h3><p>{m.text}</p><StatusPill status={m.status} class="tile-pill" /></div>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Rollout order from Pera's integration proposal: stage 1 usable immediately, then identity/HR/ITSM, then Teams/MCP. -->
  <Section id="stages" title={P.stagesTitle}>
    <ol class="tiles three" role="list">
      {P.stages.map((st, i) => (
        <li class:list={['tile', { 'tile--accent': i === 0 }]} data-reveal="drawer" style={`--d:${i * 90}ms`}>
          <p class="label stage-label">{st.label}</p>
          <div class="title-body"><h3>{st.title}</h3><p>{st.text}</p></div>
        </li>
      ))}
    </ol>
  </Section>

  <SecurityBand title={P.securityTitle} items={P.security} />

  <GoLive locale={locale} />
  <Faq locale={locale} id="integration-faq" title={P.faqTitle} items={P.faq} />

  <CtaBand id="ip-cta" title={P.ctaTitle} text={P.ctaText} cta={P.cta} />
</Base>

<style>
  /* Landscape map */
  .map { display: grid; gap: var(--spacing-gap-general-object-lg); align-items: center; padding: var(--pad-block) var(--inset); }
  .map-h { color: var(--text-neutral-subtle); margin-bottom: var(--spacing-gap-text-lg); }
  .chips, .sites { display: grid; gap: var(--spacing-gap-text-md); }
  .chip, .site { display: flex; align-items: center; height: 56px; box-sizing: border-box; gap: var(--spacing-gap-text-lg); padding: var(--spacing-padding-container-xs) var(--spacing-padding-container-sm); background: var(--surface-neutral-default); box-shadow: inset 0 0 0 var(--hair) var(--border-neutral-default); font-family: var(--font-display); font-weight: 600; color: var(--text-neutral-headings); }
  .chip svg { stroke: var(--icon-action-strong); flex: none; }
  .site svg { flex: none; }
  .lk { fill: var(--surface-neutral-default); stroke: var(--border-neutral-strong); stroke-width: var(--stroke); vector-effect: non-scaling-stroke; }
  .lk-scr { fill: #1E2530; }
  .lk-ln { stroke: var(--border-neutral-default); stroke-width: var(--stroke); vector-effect: non-scaling-stroke; }
  .map-hub { display: grid; justify-items: center; text-align: center; gap: var(--spacing-gap-text-md); padding: var(--pad-block) var(--inset); min-height: 260px; align-content: center; }
  .hub-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: var(--lh-h3); color: var(--text-neutral-onsurface); margin-top: var(--spacing-gap-text-md); }
  .hub-text { color: var(--text-neutral-ondark); max-width: 240px; }
  /* Connection lines with flowing dots (ambient, not on hover). */
  .map-link { display: none; }
  @media (min-width: 960px) {
    .map { grid-template-columns: 1fr 96px 1.1fr 96px 1fr; }
    /* Connection lines: 3px dashes in the action blue, full strength, so the three blocks read as connected. */
    .map-link { display: grid; gap: 40px; }
    .map-link span { height: 3px; background: repeating-linear-gradient(90deg, var(--border-action-default) 0 10px, transparent 10px 18px); background-size: 18px 3px; }
  }
  @media (min-width: 960px) and (prefers-reduced-motion: no-preference) {
    .map-link span { animation: flow 1.2s linear infinite; }
    .map-link span:nth-child(2) { animation-duration: 1.6s; }
    .map-link span:nth-child(3) { animation-duration: 1s; }
  }
  @keyframes flow { to { background-position: 18px 0; } }

  /* Tiles */
  .tiles { grid-auto-rows: auto; }
  .tiles .tile { grid-column: 1 / -1; grid-row: auto; min-height: 0; display: flex; flex-direction: column; gap: var(--spacing-gap-general-object-lg); }
  .tiles .tile h3 { margin: 0; }
  .tiles .tile { position: relative; }
  .tile :global(.tile-pill) { align-self: flex-start; justify-self: start; margin-top: var(--spacing-gap-text-md); }
  .stage-label { color: var(--text-action-default); }
  .tile--accent .stage-label { color: var(--text-neutral-onsurface); }
  .ic-box { display: grid; place-items: center; width: 48px; height: 48px; background: var(--surface-action-washed); transition: background-color var(--dur) var(--ease); }
  .ic-box svg { stroke: var(--icon-action-strong); transition: stroke var(--dur-fast) var(--ease); }
  .tile:hover .ic-box { background: var(--surface-action-default); }
  .tile:hover .ic-box svg { stroke: var(--icon-neutral-onsurface); }
  .tile:hover .ic-box path { animation: icon-draw 300ms var(--ease-out); }
  .ex { font-family: var(--font-display); font-weight: 600; font-size: 14px; line-height: 20px; color: var(--text-action-default) !important; }
  @media (min-width: 640px) { .tiles .tile { grid-column: span 4; } }
  @media (min-width: 960px) {
    .sys .tile { grid-column: span 3; min-height: 240px; }
    .four .tile { grid-column: span 3; min-height: 220px; }
    .three .tile { grid-column: span 4; min-height: 200px; }
  }

</style>
