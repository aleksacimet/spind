---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import TemplateHero from '../components/TemplateHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Faq from '../components/sections/Faq.astro';
import IntgMap from '../components/sections/IntgMap.astro';
import IntgStages from '../components/sections/IntgStages.astro';
import ProductMore from '../components/sections/ProductMore.astro';
import IntegrationTile from '../components/IntegrationTile.astro';
import LabelTiles from '../components/LabelTiles.astro';
import { getContent } from '../content/site';

const locale = Astro.currentLocale ?? 'en';
const t = getContent(locale ?? Astro.currentLocale);
const P = t.integrationsPage;
---
<!-- Integrations page. Two kinds of integration, kept apart: systems (software that exchanges data) and services
     (people and companies at the locker, who need no software). Order: one diagram of both kinds, systems by rollout
     stage, service partners, how a partner connects (badge or code, login, system to system), FAQ, next step, more of
     the product. Security lives on the Platform page (/platform#security). -->
<Base title={`${P.label} | Spind`} description={P.meta} locale={locale} darkHero>
  <TemplateHero id="ip" label={P.label} title={P.title} intro={P.intro} primary={P.primary} secondary={P.secondary} device="integrations" visualLabel={P.title} />

  <IntgMap />

  <IntgStages />

  <!-- Services: people and companies who handle devices at the locker. No status pills: every partner can start at level 1. -->
  <Section id="services" title={P.servicesTitle}>
    <ul class="tiles svc" role="list">
      {P.services.map((s, i) => (
        <IntegrationTile icon={s.key} title={s.title} examples={s.examples} text={s.text} delay={(i % 3) * 90} class="svc-tile" />
      ))}
    </ul>
  </Section>

  <!-- How a partner connects: badge or code (no software), a login to our application, or system to system (REST API, webhooks). -->
  <Section id="levels" title={P.levelsTitle}>
    <LabelTiles items={P.levels} />
  </Section>

  <Faq locale={locale} id="integration-faq" title={P.faqTitle} items={P.faq} />

  <CtaBand id="ip-cta" title={P.ctaTitle} text={P.ctaText} cta={P.cta} />

  <ProductMore current="integrations" />
</Base>

<style>
  .tiles { grid-auto-rows: auto; }
  @media (min-width: 960px) { .svc :global(.svc-tile) { --span: 4; } }
</style>
